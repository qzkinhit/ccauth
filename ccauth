#!/usr/bin/env python3
"""ccauth - switch Claude Code, Gemini CLI and Antigravity between accounts and providers.

Claude Code keeps one set of credentials at a time. On macOS they live in the
login Keychain; on Linux they live in a file inside the config directory. The
account identity is stored separately, in the oauthAccount field of the global
config file. ccauth saves both halves together as a named profile and writes
them back as a pair.

Repository: https://github.com/qzkinhit/ccauth
License: MIT
"""

import base64
import hashlib
import json
import os
import platform
import re
import subprocess
import sys
import time
from datetime import datetime

VERSION = "1.2.0"
NAME_RE = re.compile(r"^[A-Za-z0-9._-]{1,40}$")
RESERVED = {"save", "use", "list", "ls", "status", "current", "rm", "remove",
            "help", "version", "path", "gemini", "agy", "official"}

# Account-scoped caches in the global config. They describe the previous
# account's subscription and model entitlements, so they must be dropped on
# switch. Claude Code refetches them on the next start.
STALE_KEYS = [
    "hasAvailableSubscription", "subscriptionNoticeCount",
    "cachedExtraUsageDisabledReason", "metricsStatusCache",
    "passesEligibilityCache", "modelAccessCache", "orgModelDefaultCache",
    "additionalModelOptionsCache", "additionalModelCostsCache",
    "additionalModelOptionsAnsweredAt", "cachedUsageUtilization",
    "clientDataCacheSlots", "groveConfigCache",
]


