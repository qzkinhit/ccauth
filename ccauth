def agy_site_checkin(name):
    """Sites that grant the daily bonus on login (classic NewAPI). Returns (status, awarded, balance)."""
    site = _read_json(os.path.join(agy_sites_dir(), name + ".json"), {})
    import http.cookiejar
    base = site["url"].rstrip("/")
    op = urllib.request.build_opener(urllib.request.HTTPCookieProcessor(http.cookiejar.CookieJar()))
    per = 500000.0

    def call(path, method="GET", body=None, token=True):
        h = {"Content-Type": "application/json", "New-Api-User": str(site.get("user_id", ""))}
        if token and site.get("access_token"):
            h["Authorization"] = site["access_token"]
        req = urllib.request.Request(base + path, headers=h, method=method,
                                     data=None if body is None else json.dumps(body).encode())
        try:
            with op.open(req, timeout=30) as r:
                raw = r.read() or b"{}"
        except urllib.error.HTTPError as e:
            return {"success": False, "message": f"HTTP {e.code}"}
        try:
            return json.loads(raw)
        except ValueError:
            if b"aliyun_waf" in raw or b"captcha" in raw:
                raise RuntimeError(tt("the site's WAF asked for a captcha; will retry at the next run",
                                      "站点 WAF 要求人机验证，下次定时运行再试"))
            raise RuntimeError(tt("unexpected non-JSON reply", "站点返回了非 JSON 内容"))

    def today_award():
        r = call("/api/log/self?p=0&page_size=20&type=4")
        d = r.get("data")
        items = d.get("items") if isinstance(d, dict) else d
        start = datetime.now().replace(hour=0, minute=0, second=0, microsecond=0).timestamp()
        for it in items or []:
            if it.get("created_at", 0) >= start and "签到" in (it.get("content") or ""):
                m = re.search(r"[＄$]\s*([0-9.]+)", it.get("content") or "")
                return float(m.group(1)) if m else 0.0
        return None

    got = today_award()
    status = "already"
    if got is None:
        r = call("/api/user/login", "POST", {"username": site["username"], "password": site["password"]}, token=False)
        if not r.get("success"):
            raise RuntimeError(r.get("message") or "login failed")
        uid = (r.get("data") or {}).get("id")
        if uid and str(uid) != str(site.get("user_id") or ""):
            site["user_id"] = str(uid)
            _write_private(os.path.join(agy_sites_dir(), name + ".json"), json.dumps(site, indent=2))
        time.sleep(2)
        got = today_award()
        status = "done" if got is not None else "nobonus"
    me = call("/api/user/self").get("data") or {}
    bal = me.get("quota") / per if isinstance(me.get("quota"), (int, float)) else None
    return status, got, bal


