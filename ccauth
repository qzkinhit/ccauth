def codex_main(argv):
    if not argv:
        return ccmd_status()
    cmd, rest = argv[0], list(argv[1:])
    if cmd == "on":
        ccmd_on(_opt(rest, "--main"), _opt(rest, "--relay"))
    elif cmd == "off":
        ccmd_off()
    elif cmd in ("subagent", "sub") and len(rest) == 1:
        ccmd_set("subagent", rest[0])
    elif cmd == "main" and len(rest) == 1:
        ccmd_set("main", rest[0])
    elif cmd in ("effort", "subagent-effort") and len(rest) == 1:
        ccmd_set("subagent_effort", rest[0])
    elif cmd in ("status", "current"):
        ccmd_status()
    elif cmd in ("log", "logs"):
        ccmd_log(rest)
    elif cmd == "sync":
        codex_sync()
    elif cmd == "router":
        codex_router()
    else:
        print(CODEX_USAGE[LANG].format(version=VERSION))
        sys.exit(0 if cmd in ("help", "--help", "-h") else 1)


