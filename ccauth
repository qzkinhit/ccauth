def main():
    if platform.system() == "Windows":
        for stream in (sys.stdout, sys.stderr):
            try:
                if not stream.isatty():
                    stream.reconfigure(encoding="utf-8", errors="replace")
            except Exception:
                pass
    argv = sys.argv[1:]
    if os.path.basename(sys.argv[0]) == "gauth":
        gemini_main(argv)
        return
    if not argv:
        cmd_status()
        return
    cmd, rest = argv[0], argv[1:]
    if cmd == "gemini":
        gemini_main(rest)
        return
    if cmd == "agy":
        agy_main(rest)
        return
    if cmd == "codex":
        codex_main(rest)
        return
    if cmd == "state":
        gui_print_state()
        return
    force = "--force" in rest or "-f" in rest
    rest = [a for a in rest if a not in ("--force", "-f")]

    if cmd == "save":
        if len(rest) != 1:
            die("needs_arg", cmd=cmd)
        cmd_save(rest[0], force)
    elif cmd == "use":
        if len(rest) != 1:
            die("needs_arg", cmd=cmd)
        cmd_use(rest[0])
    elif cmd in ("rm", "remove"):
        if len(rest) != 1:
            die("needs_arg", cmd=cmd)
        cmd_rm(rest[0])
    elif cmd in ("list", "ls"):
        cmd_list()
    elif cmd in ("status", "current"):
        cmd_status()
    elif cmd == "path":
        cmd_path()
    elif cmd in ("version", "--version", "-V"):
        print(f"ccauth {VERSION}")
    elif cmd in ("help", "--help", "-h"):
        print(t("usage", version=VERSION))
    elif NAME_RE.match(cmd) and not rest:
        cmd_use(cmd)
    else:
        print(t("usage", version=VERSION))
        sys.exit(1)


if __name__ == "__main__":
    main()
