def _write_private(path, text):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".ccauth-tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write(text)
    os.replace(tmp, path)


def _read_json(path, default=None):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return default


def agy_state():
    return _read_json(agy_state_file(), {}) or {}


def agy_state_save(st):
    os.makedirs(agy_store(), exist_ok=True)
    os.chmod(STORE, 0o700)
    _write_private(agy_state_file(), json.dumps(st, indent=2))


def agy_provider_path(name):
    if not NAME_RE.match(name):
        die("bad_name", name=name)
    if name in RESERVED or name == "official":
        die("reserved", name=name)
    return os.path.join(agy_provider_dir(), name + ".json")


def agy_provider_names():
    d = agy_provider_dir()
    if not os.path.isdir(d):
        return []
    return sorted(f[:-5] for f in os.listdir(d) if f.endswith(".json"))


def agy_provider(name):
    p = _read_json(agy_provider_path(name))
    if not p:
        have = ", ".join(["official"] + agy_provider_names())
        die("not_found", name=name, have=have)
    return p


# ---- official session (macOS keychain) -----------------------------------

def agy_kc_read():
    if not IS_MAC:
        return None
    p = subprocess.run(["security", "find-generic-password", "-s", AGY_KC_SERVICE,
                        "-a", AGY_KC_ACCOUNT, "-w"], capture_output=True, text=True)
    blob = p.stdout.strip()
    return blob if p.returncode == 0 and blob else None


def agy_kc_write(blob):
    if "'" in blob:
        die("kc_quote")
    cmd = (f'add-generic-password -U -A -s "{AGY_KC_SERVICE}" '
           f'-a "{AGY_KC_ACCOUNT}" -w \'{blob}\'\n')
    subprocess.run(["security", "-i"], input=cmd, capture_output=True, text=True)
    if agy_kc_read() != blob:
        die("kc_verify")


def agy_session_file():
    return os.path.join(agy_store(), "official", "session")


def agy_session_email(blob):
    """The Google account inside a saved Antigravity session (go-keyring JSON)."""
    if not blob:
        return None
    raw = blob.split(":", 1)[1] if blob.startswith("go-keyring-base64:") else blob
    try:
        obj = json.loads(base64.b64decode(raw + "=" * (-len(raw) % 4)))
    except Exception:
        try:
            obj = json.loads(blob)
        except Exception:
            return None
    return obj.get("id_token_email") if isinstance(obj, dict) else None


def agy_official_dir():
    return os.path.join(agy_store(), "official", "profiles")


def agy_official_names():
    d = agy_official_dir()
    if not os.path.isdir(d) and os.path.exists(agy_session_file()):
        blob = _read_text(agy_session_file())
        if blob:
            agy_official_write("default", blob)
    if not os.path.isdir(d):
        return []
    return sorted(f[:-5] for f in os.listdir(d) if f.endswith(".json"))


def agy_official_read(name):
    return _read_json(os.path.join(agy_official_dir(), name + ".json"))


def agy_official_write(name, blob):
    if not NAME_RE.match(name):
        die("bad_name", name=name)
    d = {"name": name, "email": agy_session_email(blob), "blob": blob,
         "savedAt": datetime.now().astimezone().isoformat(timespec="seconds")}
    _write_private(os.path.join(agy_official_dir(), name + ".json"), json.dumps(d, indent=2))
    return d


def agy_official_by_email(email):
    for n in agy_official_names():
        if email and (agy_official_read(n) or {}).get("email") == email:
            return n
    return None


def agy_save_session(quiet=False, name=None):
    blob = agy_kc_read()
    if not blob:
        if quiet:
            return False
        agy_die("No Antigravity sign-in found in the keychain. Sign in with agy or the app first.",
                "钥匙串里没有 Antigravity 登录态，请先在 agy 或桌面版里登录 Google 账号")
    email = agy_session_email(blob)
    if not name:
        name = agy_official_by_email(email)
    if not name:
        name = "default"
        if agy_official_read("default") and agy_official_read("default").get("email") != email:
            local = re.sub(r"[^A-Za-z0-9._-]", "-", (email or "account").split("@")[0])[:40] or "account"
            name = local
    d = agy_official_write(name, blob)
    _write_private(agy_session_file(), blob)
    st = agy_state()
    st["sessionSavedAt"] = d["savedAt"]
    st["official_profile"] = name
    agy_state_save(st)
    if not quiet:
        print(tt(f"Saved the official Antigravity session as {name} ({email or '?'}).",
                 f"已保存官方 Antigravity 登录态为 {name}（{email or '?'}）"))
    return True


def acmd_accounts():
    live = agy_session_email(agy_kc_read()) if IS_MAC else None
    names = agy_official_names()
    if not names:
        print(tt("No official accounts saved yet. Sign in, then run: ccauth agy save <name>",
                 "还没有保存官方账号。登录后运行 ccauth agy save <名字>"))
        return
    for n in names:
        d = agy_official_read(n) or {}
        mark = "*" if live and d.get("email") == live else " "
        print(f"{mark} {n:<12} {d.get('email') or '?':<34} {t('saved_at', ts=d.get('savedAt'))}")


def acmd_forget(name):
    path = os.path.join(agy_official_dir(), name + ".json")
    if not os.path.exists(path):
        die("not_found", name=name, have=", ".join(agy_official_names()) or t("none_saved"))
    os.remove(path)
    print(t("removed", name=name))


def agy_switch_official_account(name):
    """Put a saved Google session into the keychain, stashing the live one first."""
    target = agy_official_read(name)
    if not target:
        die("not_found", name=name, have=", ".join(agy_official_names()) or t("none_saved"))
    live = agy_kc_read()
    live_email = agy_session_email(live)
    if live and live_email and live_email != target.get("email"):
        other = agy_official_by_email(live_email)
        if other and other != name:
            agy_official_write(other, live)
            print(t("restashed", name=other))
    agy_kc_write(target["blob"])
    _write_private(agy_session_file(), target["blob"])
    cache = agy_cache_dir()
    if os.path.isdir(cache):
        for f in os.listdir(cache):
            if f.endswith(".json"):
                os.remove(os.path.join(cache, f))
    st = agy_state()
    st["official_profile"] = name
    agy_state_save(st)
    print(tt(f"Google account: {name} ({target.get('email') or '?'})",
             f"官方账号已换成 {name}（{target.get('email') or '?'}）"))


# ---- installation ids ------------------------------------------------------

def agy_id_files():
    return {"cli": os.path.join(agy_cli_dir(), "installation_id"),
            "app": os.path.join(agy_app_dir(), "installation_id")}


def _read_text(path):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return None


def agy_ids_apply(owner):
    """owner is 'official' or a provider name. Ids are kept per owner."""
    keep = os.path.join(agy_store(), "ids")
    st = agy_state()
    current_owner = st.get("idOwner", "official")
    for kind, path in agy_id_files().items():
        live = _read_text(path)
        if live:
            _write_private(os.path.join(keep, f"{current_owner}.{kind}"), live)
        want = _read_text(os.path.join(keep, f"{owner}.{kind}"))
        if not want:
            if owner == "official":
                continue
            want = str(uuid.uuid4())
            _write_private(os.path.join(keep, f"{owner}.{kind}"), want)
        if os.path.isdir(os.path.dirname(path)):
            with open(path, "w") as f:
                f.write(want)
    st["idOwner"] = owner
    agy_state_save(st)


