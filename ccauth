AGY_CHEAP_PREFIX = re.compile(r"(?:^|\n|>)\s*@h(?:\s|$)")


def agy_last_user_text(contents):
    if not isinstance(contents, list) or not contents:
        return ""
    last = contents[-1] if isinstance(contents[-1], dict) else {}
    return "\n".join(p.get("text", "") for p in last.get("parts") or [] if isinstance(p, dict))


AGY_MAIN_PREFIX = re.compile(r"(?:^|\n|>)\s*@m(?:\s|$)")
AGY_WRITING_WORDS = [
    "写作", "撰写", "写一段", "写一篇", "写段", "润色", "改写", "重写", "扩写", "改稿", "修改稿",
    "翻译", "论文", "摘要", "引言", "正文", "段落", "措辞", "文案", "表述", "行文", "语句",
    "去ai", "审稿", "回复审稿", "rebuttal", "cover letter", "读者", "文章", "报告", "邮件",
    "polish", "rewrite", "rephrase", "paraphrase", "proofread", "translate", "wording",
    "manuscript", "paper", "abstract", "introduction", "essay", "prose",
    ".tex", ".docx", ".md",
]


def agy_question(contents):
    """The user's own words of the newest question, without the app's metadata."""
    for c in reversed(contents or []):
        if not isinstance(c, dict) or c.get("role") != "user":
            continue
        parts = c.get("parts") or []
        if any(isinstance(p, dict) and "functionResponse" in p for p in parts):
            continue
        text = "\n".join(p.get("text", "") for p in parts if isinstance(p, dict))
        m = re.search(r"<USER_REQUEST>(.*?)</USER_REQUEST>", text, re.S)
        if not m and agy_uses_tags(contents):
            continue
        return (m.group(1) if m else text).strip()
    return ""


def agy_route_reason(prov, contents):
    """Why a whole question is pinned to one model: ('cheap'|'main', reason) or (None, '')."""
    q = agy_question(contents)
    if AGY_CHEAP_PREFIX.search(q):
        return "cheap", "@h"
    if AGY_MAIN_PREFIX.search(q):
        return "main", "@m"
    if prov.get("writing", False):
        low = q.lower()
        words = prov.get("writing_words") or AGY_WRITING_WORDS
        for w in words:
            if w.lower() in low:
                return "main", "writing:" + w
    return None, ""


def agy_add_hint(payload, text):
    si = payload.get("systemInstruction")
    if not isinstance(si, dict):
        si = {"parts": []}
    parts = list(si.get("parts") or [])
    if not any(isinstance(p, dict) and p.get("text") == text for p in parts):
        parts.append({"text": text})
    si["parts"] = parts
    payload["systemInstruction"] = si


AGY_SKIP_SIGNATURE = "skip_thought_signature_validator"


def agy_patch_signatures(contents):
    """Replace thought signatures so another model accepts the history."""
    changed = False
    for c in contents or []:
        if not isinstance(c, dict) or c.get("role") != "model":
            continue
        for part in c.get("parts") or []:
            if not isinstance(part, dict):
                continue
            if "thoughtSignature" in part or "functionCall" in part:
                if part.get("thoughtSignature") != AGY_SKIP_SIGNATURE:
                    part["thoughtSignature"] = AGY_SKIP_SIGNATURE
                    changed = True
    return changed


AGY_KEY_ERRORS = ("额度", "余额", "quota", "insufficient", "invalid token", "invalid api key",
                  "无效的令牌", "令牌", "已过期", "已用尽", "expired", "exhausted", "balance")
AGY_POOL_ERRORS = ("cooling down", "credentials for model", "no available channel", "无可用渠道")


def agy_key_exhausted(code, raw):
    """The relay rejected this key (quota used up, expired, invalid), not a shared upstream outage."""
    if code not in (401, 402, 403, 429):
        return False
    low = (raw or b"").decode("utf-8", "replace").lower()
    if any(w in low for w in AGY_POOL_ERRORS):
        return False
    return any(w in low for w in AGY_KEY_ERRORS)


def agy_next_midnight():
    now = datetime.now().astimezone()
    tomorrow = (now + __import__("datetime").timedelta(days=1)).replace(hour=0, minute=0, second=0, microsecond=0)
    return tomorrow.isoformat(timespec="seconds")


def agy_exhausted(name):
    until = (agy_state().get("exhausted") or {}).get(name)
    if not until:
        return False
    try:
        return datetime.fromisoformat(until) > datetime.now().astimezone()
    except ValueError:
        return False


def agy_mark_exhausted(name, on):
    st = agy_state()
    ex = dict(st.get("exhausted") or {})
    if on:
        ex[name] = agy_next_midnight()
    elif name in ex:
        ex.pop(name)
    else:
        return
    st["exhausted"] = ex
    agy_state_save(st)


def agy_chain(prov):
    """The active provider followed by its fallbacks; providers used up today go last."""
    seen, chain, cur = set(), [], prov
    while cur and cur.get("name") not in seen:
        seen.add(cur.get("name"))
        chain.append(cur)
        nxt = cur.get("fallback")
        cur = _read_json(os.path.join(agy_provider_dir(), nxt + ".json")) if nxt else None
    fresh = [c for c in chain if not agy_exhausted(c.get("name"))]
    return fresh + [c for c in chain if c not in fresh]


def agy_strip_images(contents, keep_last):
    """Replace inline images (except in the newest message when keep_last) by a short note."""
    n = 0
    items = contents or []
    upto = len(items) - 1 if keep_last else len(items)
    for c in items[:upto]:
        if not isinstance(c, dict):
            continue
        parts = c.get("parts") or []
        for i, part in enumerate(parts):
            if not isinstance(part, dict):
                continue
            if "inlineData" in part or "inline_data" in part:
                parts[i] = {"text": "[image omitted by the local bridge to keep the request under the relay size limit]"}
                n += 1
            fr = part.get("functionResponse")
            if isinstance(fr, dict) and isinstance(fr.get("parts"), list):
                kept = []
                for sub in fr["parts"]:
                    if isinstance(sub, dict) and ("inlineData" in sub or "inline_data" in sub):
                        n += 1
                    else:
                        kept.append(sub)
                fr["parts"] = kept
    return n


# ---- the bridge ------------------------------------------------------------

def agy_bridge():
    from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
    import gzip

    log_lock = __import__("threading").Lock()

    def log(*a):
        with log_lock:
            print(time.strftime("%Y-%m-%d %H:%M:%S"), *a, flush=True)

    direct = urllib.request.build_opener(urllib.request.ProxyHandler({}))
    proxy = os.environ.get("HTTPS_PROXY") or os.environ.get("https_proxy")
    google = urllib.request.build_opener(urllib.request.ProxyHandler(
        {"http": proxy, "https": proxy} if proxy else {}))
    upstream = os.environ.get("CCAUTH_AGY_UPSTREAM", "https://daily-cloudcode-pa.googleapis.com")

    def active():
        st = agy_state()
        name = st.get("active")
        if not name or name == "official":
            return None
        return _read_json(os.path.join(agy_provider_dir(), name + ".json"))

    def code_of(r):
        return getattr(r, "status", None) or r.code

    class Handler(BaseHTTPRequestHandler):
        protocol_version = "HTTP/1.1"

        def log_message(self, *a):
            pass

        def body(self):
            if "chunked" in (self.headers.get("Transfer-Encoding") or "").lower():
                buf = b""
                while True:
                    size = int(self.rfile.readline().strip().split(b";")[0] or b"0", 16)
                    if size == 0:
                        self.rfile.readline()
                        break
                    buf += self.rfile.read(size)
                    self.rfile.readline()
            else:
                n = int(self.headers.get("Content-Length") or 0)
                buf = self.rfile.read(n) if n else b""
            if (self.headers.get("Content-Encoding") or "").lower() == "gzip":
                buf = gzip.decompress(buf)
            return buf

        def send(self, code, data, ctype="application/json"):
            self.send_response(code)
            self.send_header("Content-Type", ctype)
            self.send_header("Content-Length", str(len(data)))
            self.end_headers()
            self.wfile.write(data)

        def error(self, code, msg):
            self.send(code, json.dumps({"error": {"code": code, "message": msg}}).encode())

        def do_GET(self):
            if self.path.startswith("/ccauth/health"):
                return self.send(200, b'{"ok":true}')
            self.account_call(b"")

        def do_POST(self):
            data = self.body()
            op = self.path.split("?")[0].rsplit(":", 1)[-1] if ":" in self.path else ""
            prov = active()
            try:
                if prov and self.path.startswith("/v1internal:") and op in AGY_GEN_OPS:
                    return self.cloudcode_gen(prov, op, data)
                if prov and "/models/" in self.path:
                    return self.gemini_api(prov, data)
            except (BrokenPipeError, ConnectionResetError):
                log("client closed", self.path.split("?")[0])
                return
            except Exception as e:
                log("error", self.path.split("?")[0], repr(e))
                try:
                    return self.error(502, "ccauth bridge: " + str(e))
                except (BrokenPipeError, ConnectionResetError):
                    return
            self.account_call(data)

        # Account calls of the desktop app. Served from the local cache in
        # third-party mode; a call that has never been seen is fetched once.
        def account_call(self, data):
            path = self.path.split("?")[0]
            op = path.rsplit(":", 1)[-1] if ":" in path else (
                re.sub(r"[^A-Za-z0-9._-]+", "_", path.strip("/")) or "root")
            prov = active()
            cache = os.path.join(agy_cache_dir(), op + ".json")
            raw = None
            if prov and os.path.exists(cache):
                with open(cache, "rb") as f:
                    raw = f.read()
                log("local", op)
            if raw is None:
                hdr = {k: v for k, v in self.headers.items()
                       if k.lower() not in ("host", "content-length", "accept-encoding",
                                            "connection", "transfer-encoding", "content-encoding")}
                req = urllib.request.Request(upstream + self.path,
                                             data=data if self.command == "POST" else None,
                                             headers=hdr, method=self.command)
                try:
                    r = google.open(req, timeout=600)
                except urllib.error.HTTPError as e:
                    r = e
                except Exception as e:
                    return self.error(502, "ccauth bridge: " + str(e))
                raw = r.read()
                code = code_of(r)
                log("google", op, code)
                if code != 200:
                    return self.send(code, raw, r.headers.get("Content-Type", "application/json"))
                os.makedirs(agy_cache_dir(), exist_ok=True)
                _write_private(cache, raw.decode("utf-8", "replace"))
            if prov:
                try:
                    obj = json.loads(raw or b"{}")
                    if op == "fetchAvailableModels":
                        obj = agy_rewrite_models(obj, prov.get("models") or [])
                    elif op == "retrieveUserQuotaSummary":
                        obj = agy_rewrite_quota(obj)
                    raw = json.dumps(obj).encode()
                except ValueError:
                    pass
            self.send(200, raw)

        def relay(self, prov, model, op, payload, stream):
            url = (prov["url"].rstrip("/") + f"/v1beta/models/{model}:{op}"
                   + ("?alt=sse" if stream else ""))
            req = urllib.request.Request(url, data=json.dumps(payload).encode(), method="POST",
                                         headers={"Content-Type": "application/json",
                                                  "x-goog-api-key": prov["key"]})
            try:
                return direct.open(req, timeout=1800)
            except urllib.error.HTTPError as e:
                return e

        def stream_back(self, r, wrap):
            self.send_response(200)
            self.send_header("Content-Type", "text/event-stream")
            self.send_header("Transfer-Encoding", "chunked")
            self.end_headers()
            for raw in r:
                line = raw.decode("utf-8", "replace").strip()
                if not line.startswith("data:"):
                    continue
                try:
                    obj = json.loads(line[5:].strip())
                except ValueError:
                    continue
                obj.pop("billing_usage", None)
                if isinstance(obj.get("usageMetadata"), dict):
                    obj["usageMetadata"].pop("billing_usage", None)
                out = ("data: " + json.dumps({"response": obj} if wrap else obj)
                       + "\r\n\r\n").encode()
                self.wfile.write(b"%x\r\n%s\r\n" % (len(out), out))
                self.wfile.flush()
            self.wfile.write(b"0\r\n\r\n")

        @staticmethod
        def clean(payload):
            for k in ("sessionId", "session_id", "labels", "cachedContent", "model"):
                payload.pop(k, None)
            tc = (payload.get("generationConfig") or {}).get("thinkingConfig")
            if isinstance(tc, dict) and isinstance(tc.get("thinkingLevel"), (int, float)):
                # The app sends an enum number; relays expect a string. The relay model name
                # already fixes the thinking level, so the field is dropped.
                tc.pop("thinkingLevel")
            return payload

        def pick(self, prov, asked, payload):
            """Main model for a fresh user turn, the cheap model for tool-result steps."""
            models = prov.get("models") or []
            default = prov.get("default") if prov.get("default") in models else agy_best_model(models)
            model = agy_map_model(asked, models, default or asked)
            cheap = prov.get("cheap")
            contents = payload.get("contents")
            step = agy_is_tool_step(contents)
            kind = "tool-step" if step else "user-turn"
            if cheap and _family(model) not in ("flash", "flash-lite"):
                pin, why = agy_route_reason(prov, contents)
                if pin == "cheap":
                    return cheap, kind + " " + why
                if pin == "main":
                    return model, kind + " " + why
                writer = prov.get("writer")
                if step and writer and agy_write_marked(contents):
                    return writer, kind + " writing"
                if step:
                    return cheap, kind
            return model, kind

        def generate(self, prov, op, asked, payload, stream, wrap):
            if op == "countTokens":
                n = len(json.dumps(payload.get("contents", payload))) // 4
                return self.send(200, json.dumps({"totalTokens": n}).encode())
            agy_refresh_models(prov)
            model, kind = self.pick(prov, asked, payload)
            wanted = model
            model = agy_available(model, prov)
            if model != wanted:
                kind += f" ({wanted} unavailable)"
            hint = prov.get("hint")
            if hint and _family(model) not in ("flash", "flash-lite"):
                agy_add_hint(payload, AGY_HINT if hint is True else hint)
                if prov.get("writer") and prov.get("cheap"):
                    agy_add_hint(payload, AGY_WRITER_RULE)
                kind += " +hint"
            log("relay", op, asked, "->", model, kind)
            chain = agy_chain(prov)
            for i, cand in enumerate(chain):
                cm = model
                if cand is not prov and cand.get("models") and model not in cand["models"]:
                    cm = agy_map_model(model, cand["models"], cand.get("default") or cand["models"][0])
                r = self.relay(cand, cm, op, payload, stream)
                raw = None
                if code_of(r) in (400, 404, 503):
                    raw = r.read()
                    if agy_model_gone(code_of(r), raw):
                        agy_refresh_models(cand, force=True)
                        alt = agy_available(cm, cand)
                        if alt == cm:
                            alt = agy_best_model([m for m in (cand.get("models") or []) if m != cm])
                        if alt and alt != cm:
                            log("relay-retry", cm, "has no channel, using", alt)
                            cm = alt
                            r = self.relay(cand, cm, op, payload, stream)
                            raw = None
                    if raw is not None and code_of(r) != 400:
                        log("relay-error", code_of(r), raw[:300])
                        return self.send(code_of(r), raw)
                if code_of(r) == 400:
                    if raw is None:
                        raw = r.read()
                    if b"signature" in raw.lower() and agy_patch_signatures(payload.get("contents")):
                        log("relay-retry", "thought signatures replaced")
                        r = self.relay(cand, cm, op, payload, stream)
                    else:
                        log("relay-error", 400, raw[:300])
                        return self.send(400, raw)
                for keep_last in (True, False):
                    if code_of(r) != 413:
                        break
                    r.read()
                    n = agy_strip_images(payload.get("contents"), keep_last)
                    if not n:
                        continue
                    log("relay-retry", "413 too large, removed", n, "older images" if keep_last else "images")
                    r = self.relay(cand, cm, op, payload, stream)
                if code_of(r) == 200:
                    if agy_exhausted(cand.get("name")):
                        agy_mark_exhausted(cand.get("name"), False)
                    break
                raw = r.read()
                if agy_key_exhausted(code_of(r), raw) and i + 1 < len(chain):
                    agy_mark_exhausted(cand.get("name"), True)
                    log("key-exhausted", cand.get("name"), code_of(r), raw[:160],
                        "-> retry with", chain[i + 1].get("name"))
                    continue
                if agy_key_exhausted(code_of(r), raw):
                    agy_mark_exhausted(cand.get("name"), True)
                log("relay-error", code_of(r), raw[:300])
                return self.send(code_of(r), raw)
            if not stream:
                obj = json.loads(r.read())
                return self.send(200, json.dumps({"response": obj} if wrap else obj).encode())
            self.stream_back(r, wrap)

        # Desktop app path: Cloud Code envelope -> plain Gemini API.
        def cloudcode_gen(self, prov, op, data):
            j = json.loads(data or b"{}")
            inner = self.clean(dict(j.get("request") or {}))
            self.generate(prov, op, j.get("model"), inner, op == "streamGenerateContent", True)

        # agy GEMINI_API_KEY path.
        def gemini_api(self, prov, data):
            path = self.path.split("?")[0]
            asked, _, op = path.split("/models/", 1)[1].partition(":")
            payload = self.clean(json.loads(data or b"{}"))
            self.generate(prov, op, asked, payload, "alt=sse" in self.path, False)

    if IS_MAC and active():
        subprocess.run(["launchctl", "setenv", "CLOUD_CODE_URL", f"http://127.0.0.1:{AGY_PORT}"],
                       capture_output=True)
    log("bridge listening on", AGY_PORT)
    ThreadingHTTPServer(("127.0.0.1", AGY_PORT), Handler).serve_forever()


