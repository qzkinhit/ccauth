class AgySession:
    """Login state for one NewAPI account: a rotating refresh cookie plus a short-lived access token."""

    def __init__(self, prov):
        import http.cookiejar
        self.prov = prov
        self.base = prov["url"].rstrip("/")
        self.acct = dict(prov.get("account") or {})
        self.jar = http.cookiejar.CookieJar()
        self.op = urllib.request.build_opener(urllib.request.HTTPCookieProcessor(self.jar))
        self.token = None

    def _json(self, path, method="GET", body=None, auth=True):
        h = {"Content-Type": "application/json"}
        if auth and self.token:
            h["Authorization"] = "Bearer " + self.token
            h["New-Api-User"] = str(self.acct.get("user_id", ""))
        if auth and self.acct.get("refresh") and not self.token:
            h["Cookie"] = "new_api_refresh=" + self.acct["refresh"]
        data = None if body is None else json.dumps(body).encode()
        req = urllib.request.Request(self.base + path, data=data, headers=h, method=method)
        try:
            with self.op.open(req, timeout=30) as r:
                out = json.loads(r.read() or b"{}")
        except urllib.error.HTTPError as e:
            try:
                out = json.loads(e.read() or b"{}")
            except ValueError:
                out = {}
            out.setdefault("success", False)
            out.setdefault("message", f"HTTP {e.code}")
        for c in self.jar:
            if c.name == "new_api_refresh":
                self.acct["refresh"] = c.value
        return out

    def _take(self, r):
        d = r.get("data") or {}
        if r.get("success") and d.get("access_token"):
            self.token = d["access_token"]
            u = d.get("user") or {}
            if u.get("id"):
                self.acct["user_id"] = u["id"]
            return True
        return False

    def login(self, password):
        r = self._json("/api/user/login", "POST",
                       {"username": self.acct["username"], "password": password}, auth=False)
        if not self._take(r):
            raise RuntimeError(r.get("message") or "login failed")

    def ensure(self):
        if self.acct.get("refresh") and self._take(self._json("/api/user/auth/refresh", "POST", {})):
            return "refresh"
        pw = self.acct.get("password")
        if not pw:
            raise RuntimeError(tt("session expired and no password saved; run ccauth agy login",
                                  "登录已过期且没有保存密码，请运行 ccauth agy login"))
        self.login(pw)
        return "password"

    def save(self):
        p = _read_json(os.path.join(agy_provider_dir(), self.prov["name"] + ".json"), {})
        p["account"] = self.acct
        _write_private(os.path.join(agy_provider_dir(), self.prov["name"] + ".json"), json.dumps(p, indent=2))

    def checkin(self):
        """(status, dollars awarded today or None, balance dollars or None)."""
        per = 500000.0
        st = self._json("/api/user/checkin")
        stats = (st.get("data") or {}).get("stats") or {}
        status = "already"
        if not stats.get("checked_in_today"):
            r = self._json("/api/user/checkin", "POST", {})
            if not r.get("success") and "already" not in (r.get("message") or "").lower():
                raise RuntimeError(r.get("message") or "check-in failed")
            status = "done"
            stats = ((self._json("/api/user/checkin").get("data") or {}).get("stats") or {})
        today = datetime.now().strftime("%Y-%m-%d")
        got = None
        for rec in stats.get("records") or []:
            if rec.get("checkin_date") == today:
                got = (rec.get("quota_awarded") or 0) / per
        me = self._json("/api/user/self").get("data") or {}
        bal = me.get("quota") / per if isinstance(me.get("quota"), (int, float)) else None
        return status, got, bal


