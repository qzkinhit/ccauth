# ---- bridge service (launchd) --------------------------------------------

def agy_script_path():
    return os.path.realpath(sys.argv[0])


def agy_service_start():
    if not IS_MAC:
        return
    py = sys.executable or "/usr/bin/python3"
    log = os.path.join(agy_store(), "bridge.log")
    plist = f"""<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>{AGY_LABEL}</string>
  <key>ProgramArguments</key><array>
    <string>{py}</string><string>{agy_script_path()}</string>
    <string>agy</string><string>bridge</string>
  </array>
  <key>EnvironmentVariables</key><dict>
    <key>CCAUTH_HOME</key><string>{STORE}</string>
    <key>HTTPS_PROXY</key><string>{os.environ.get("HTTPS_PROXY") or os.environ.get("https_proxy") or ""}</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>{log}</string>
  <key>StandardErrorPath</key><string>{log}</string>
</dict></plist>
"""
    os.makedirs(os.path.dirname(agy_plist()), exist_ok=True)
    with open(agy_plist(), "w") as f:
        f.write(plist)
    uid = str(os.getuid())
    subprocess.run(["launchctl", "bootout", f"gui/{uid}/{AGY_LABEL}"], capture_output=True)
    subprocess.run(["launchctl", "bootstrap", f"gui/{uid}", agy_plist()], capture_output=True)
    subprocess.run(["launchctl", "setenv", "CLOUD_CODE_URL", f"http://127.0.0.1:{AGY_PORT}"],
                   capture_output=True)


def agy_service_stop():
    if not IS_MAC:
        return
    uid = str(os.getuid())
    subprocess.run(["launchctl", "bootout", f"gui/{uid}/{AGY_LABEL}"], capture_output=True)
    if os.path.exists(agy_plist()):
        os.remove(agy_plist())
    subprocess.run(["launchctl", "unsetenv", "CLOUD_CODE_URL"], capture_output=True)


def agy_bridge_alive():
    try:
        with urllib.request.build_opener(urllib.request.ProxyHandler({})).open(
                f"http://127.0.0.1:{AGY_PORT}/ccauth/health", timeout=2) as r:
            return r.status == 200
    except Exception:
        return False


def agy_running():
    out = []
    for pat, label in (("Antigravity.app/Contents/MacOS", "Antigravity"),
                       ("/.local/bin/agy", "agy")):
        try:
            p = subprocess.run(["pgrep", "-f", pat], capture_output=True, text=True, timeout=5)
            if p.stdout.strip():
                out.append(label)
        except Exception:
            pass
    return out


# ---- relay model discovery and mapping -----------------------------------

def agy_fetch_models(url, key):
    req = urllib.request.Request(url.rstrip("/") + "/v1/models",
                                 headers={"Authorization": "Bearer " + key})
    with urllib.request.urlopen(req, timeout=30) as r:
        data = json.loads(r.read())
    ids = [m.get("id", "") for m in data.get("data", [])]
    return sorted(i for i in ids if i.lower().startswith("gemini"))


def _level(name):
    tail = name.rsplit("-", 1)[-1]
    return tail if tail in AGY_LEVELS else ""


def _family(name):
    n = name.lower()
    for fam in ("argon", "carbon", "hydrogen", "flash-lite", "flash", "pro"):
        if fam in n:
            return fam
    return ""


def agy_map_model(asked, models, default):
    """Pick the relay model for a model id the app asked for."""
    m = (asked or "").split("/")[-1].lower()
    if m in models:
        return m
    base = m[:-len(_level(m)) - 1] if _level(m) else m
    same = [x for x in models if x.lower() == base or x.lower().startswith(base + "-")]
    if not same:
        fam = _family(m)
        if fam == "flash-lite":
            same = [x for x in models if "flash" in x.lower()]
        elif fam:
            same = [x for x in models if fam in x.lower()]
    if not same:
        return default
    want = _level(m)
    for x in same:
        if want and _level(x) == want:
            return x
    order = {lv: i for i, lv in enumerate(AGY_LEVELS)}
    same.sort(key=lambda x: order.get(_level(x), len(AGY_LEVELS)))
    return same[0]


def agy_rewrite_models(data, models):
    """Unlock what the relay serves in the app's model picker."""
    ms = data.get("models")
    if not isinstance(ms, dict):
        return data
    relay_fams = {_family(x) for x in models}
    hide = []
    for key, v in ms.items():
        if not isinstance(v, dict):
            continue
        if v.get("modelProvider") in ("MODEL_PROVIDER_ANTHROPIC", "MODEL_PROVIDER_OPENAI"):
            hide.append(key)
            continue
        if isinstance(v.get("quotaInfo"), dict):
            v["quotaInfo"] = {"remainingFraction": 1}
    if "carbon" in relay_fams:
        old = ms.pop("gemini-4-carbon-disabled", None)
        if old and "gemini-4-carbon-high" not in ms:
            for k in ("disabled", "tagTitle", "tagDescription"):
                old.pop(k, None)
            old["displayName"] = "Gemini 4 Carbon (High)"
            old["thinkingLevel"] = 3
            old["quotaInfo"] = {"remainingFraction": 1}
            ms["gemini-4-carbon-high"] = old
    for sort in data.get("agentModelSorts") or []:
        for g in sort.get("groups") or []:
            ids = [i if i != "gemini-4-carbon-disabled" else "gemini-4-carbon-high"
                   for i in g.get("modelIds") or []]
            g["modelIds"] = [i for i in ids if i not in hide and i in ms]
    return data


def agy_rewrite_quota(data):
    def walk(o):
        if isinstance(o, dict):
            if "remainingFraction" in o:
                o["remainingFraction"] = 1
                o.pop("description", None)
            for v in o.values():
                walk(v)
        elif isinstance(o, list):
            for v in o:
                walk(v)
    walk(data)
    return data


def agy_uses_tags(contents):
    """Antigravity wraps what the user typed in <USER_REQUEST>; other user-role text is the app's."""
    for c in contents or []:
        if isinstance(c, dict) and c.get("role") == "user":
            for p in c.get("parts") or []:
                if isinstance(p, dict) and "<USER_REQUEST>" in (p.get("text") or ""):
                    return True
    return False


def agy_is_tool_step(contents):
    """True when the newest message is not something the user typed: tool results, or an
    app notice such as a finished background command."""
    if not isinstance(contents, list) or not contents:
        return False
    last = contents[-1] if isinstance(contents[-1], dict) else {}
    parts = last.get("parts") or []
    if any(isinstance(p, dict) and "functionResponse" in p for p in parts):
        return True
    if last.get("role") == "user" and agy_uses_tags(contents):
        text = "".join(p.get("text") or "" for p in parts if isinstance(p, dict))
        return "<USER_REQUEST>" not in text
    return False


AGY_WRITE_MARK = "【写作】"
AGY_WRITER_RULE = (
    "Model routing: requests that follow tool results run on a cheaper model, except writing. "
    "Writing means drafting or revising documents, reports, papers, slide text, speaker notes, "
    "emails, review files or a long final written answer. When your next step is writing, begin "
    "your message with " + AGY_WRITE_MARK + " and in the same turn issue any reads you still need; "
    "the following step then runs on the writer model. Keep " + AGY_WRITE_MARK + " at the start of "
    "each message while writing is still in progress, and drop it once the writing is done. Do not "
    "use the marker for research, reading, searching, running commands or code edits. When you plan "
    "a task, state which steps are writing.")


def agy_write_marked(contents):
    """The newest model message starts with the writing marker."""
    for c in reversed(contents or []):
        if not isinstance(c, dict) or c.get("role") != "model":
            continue
        for p in c.get("parts") or []:
            if isinstance(p, dict) and not p.get("thought") and AGY_WRITE_MARK in (p.get("text") or "")[:200]:
                return True
        return False
    return False


AGY_HINT = ("Billing note from the user: every model request in this session is billed per call. "
            "Keep the number of requests low without lowering the quality of the result. "
            "Issue all independent tool calls together in one turn (read several files at once, "
            "run independent searches and commands in parallel). When file paths are known, read "
