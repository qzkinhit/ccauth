GEMINI_KC_SERVICE = "gemini-cli-oauth"
GEMINI_KC_ACCOUNT = "main-account"


def gemini_config_dir():
    d = os.environ.get("GEMINI_CONFIG_DIR")
    if d:
        return d
    cli_home = os.environ.get("GEMINI_CLI_HOME")
    return os.path.join(cli_home, ".gemini") if cli_home else os.path.join(HOME, ".gemini")


def gemini_oauth_file():
    return os.path.join(gemini_config_dir(), "oauth_creds.json")


def gemini_accounts_file():
    return os.path.join(gemini_config_dir(), "google_accounts.json")


def gemini_store():
    return os.path.join(STORE, "gemini")


def gemini_kc_read():
    if not IS_MAC:
        return None
    p = subprocess.run(
        ["security", "find-generic-password", "-s", GEMINI_KC_SERVICE,
         "-a", GEMINI_KC_ACCOUNT, "-w"],
        capture_output=True, text=True)
    blob = p.stdout.strip()
    return blob if p.returncode == 0 and blob else None


def gemini_kc_write(blob):
    if not IS_MAC:
        return
    if "'" in blob:
        die("kc_quote")
    cmd = (f'add-generic-password -U -A -s "{GEMINI_KC_SERVICE}" '
           f'-a "{GEMINI_KC_ACCOUNT}" -w \'{blob}\'\n')
    subprocess.run(["security", "-i"], input=cmd,
                   capture_output=True, text=True)
    if gemini_kc_read() != blob:
        die("kc_verify")


def gemini_kc_delete():
    if not IS_MAC:
        return
    subprocess.run(
        ["security", "delete-generic-password", "-s", GEMINI_KC_SERVICE,
         "-a", GEMINI_KC_ACCOUNT],
        capture_output=True, text=True)


def gemini_oauth_read():
    try:
        with open(gemini_oauth_file()) as f:
            blob = f.read().strip()
        return blob or None
    except OSError:
        return None


def gemini_oauth_write(blob):
    path = gemini_oauth_file()
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".ccauth-tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write(blob)
    os.replace(tmp, path)


def gemini_oauth_delete():
    path = gemini_oauth_file()
    if os.path.exists(path):
        os.remove(path)


def gemini_accounts_load():
    path = gemini_accounts_file()
    try:
        with open(path) as f:
            return json.load(f)
    except FileNotFoundError:
        return {}
    except json.JSONDecodeError as e:
        die("cfg_parse", path=path, err=e)


def gemini_accounts_save(data):
    path = gemini_accounts_file()
    os.makedirs(os.path.dirname(path), exist_ok=True)
    gstore = gemini_store()
    os.makedirs(gstore, exist_ok=True)
    if os.path.exists(path):
        bak = os.path.join(gstore, "google_accounts.json.bak")
        fd = os.open(bak, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with open(path) as src, os.fdopen(fd, "w") as dst:
            dst.write(src.read())
    tmp = path + ".ccauth-tmp"
    with open(tmp, "w") as f:
        json.dump(data, f, indent=2)
    os.replace(tmp, path)


def _jwt_email(id_token):
    try:
        parts = id_token.split(".")
        if len(parts) < 2:
            return None
        payload = parts[1] + "=" * (-len(parts[1]) % 4)
        data = json.loads(base64.urlsafe_b64decode(payload).decode("utf-8"))
        return data.get("email")
    except Exception:
        return None


def gemini_extract_email(accounts, oauth_blob, kc_blob):
    if isinstance(accounts, dict) and accounts.get("active"):
        return accounts["active"]
    for blob in (oauth_blob, kc_blob):
        if not blob:
            continue
        try:
            obj = json.loads(blob)
        except Exception:
            continue
        tok = obj.get("token") if isinstance(obj.get("token"), dict) else obj
        id_tok = tok.get("id_token") or tok.get("idToken")
        if id_tok:
            email = _jwt_email(id_tok)
            if email:
                return email
    return "unknown"


def gemini_expiry_note(oauth_blob, kc_blob):
    for blob in (kc_blob, oauth_blob):
        if not blob:
            continue
        try:
            obj = json.loads(blob)
        except Exception:
            continue
        tok = obj.get("token") if isinstance(obj.get("token"), dict) else obj
        ms = tok.get("expiry_date") or tok.get("expiresAt")
        if isinstance(ms, (int, float)):
            left = (ms / 1000.0 - time.time()) / 3600.0
            return t("expired") if left <= 0 else t("expires_in", hours=left)
    return None


def gemini_running():
    try:
        p = subprocess.run(["pgrep", "-f", "gemini"],
                           capture_output=True, text=True, timeout=5)
        for line in p.stdout.strip().splitlines():
            pid = line.strip()
            if pid and int(pid) != os.getpid():
                return True
        return False
    except Exception:
        return False


def gprof_path(name):
    if not NAME_RE.match(name):
        die("bad_name", name=name)
    if name in RESERVED:
        die("reserved", name=name)
    return os.path.join(gemini_store(), name + ".json")


def gprof_names():
    gstore = gemini_store()
    if not os.path.isdir(gstore):
        return []
    return sorted(f[:-5] for f in os.listdir(gstore)
                  if f.endswith(".json") and not f.startswith("google_accounts.json"))


def gprof_read(name):
    try:
        with open(gprof_path(name)) as f:
            return json.load(f)
    except FileNotFoundError:
        have = "、".join(gprof_names()) if gprof_names() else t("none_saved")
        die("not_found", name=name, have=have)


def gprof_write(name, email, oauth_blob, kc_blob, accounts):
    os.makedirs(STORE, exist_ok=True)
    os.chmod(STORE, 0o700)
    gstore = gemini_store()
    os.makedirs(gstore, exist_ok=True)
    os.chmod(gstore, 0o700)
    data = {
        "label": name,
        "provider": "gemini",
        "email": email,
        "savedAt": datetime.now().astimezone().isoformat(timespec="seconds"),
        "oauthCreds": oauth_blob,
        "keychainCreds": kc_blob,
        "googleAccounts": accounts,
    }
    path = gprof_path(name)
    tmp = path + ".tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        json.dump(data, f, indent=2)
    os.replace(tmp, path)
    return data


def gcmd_save(name, force=False):
    if os.path.exists(gprof_path(name)) and not force:
        old = gprof_read(name)
        die("exists", name=name, email=old.get("email"))
    oauth_blob = gemini_oauth_read()
    kc_blob = gemini_kc_read()
    if not oauth_blob and not kc_blob:
        die("gemini_no_creds")
    accounts = gemini_accounts_load()
    email = gemini_extract_email(accounts, oauth_blob, kc_blob)
    d = gprof_write(name, email, oauth_blob, kc_blob, accounts)
    print(t("saved", name=name, email=d["email"]))


def gcmd_use(name):
    target = gprof_read(name)
    live_oauth = gemini_oauth_read()
    live_kc = gemini_kc_read()
    live_accounts = gemini_accounts_load()
    here = gemini_extract_email(live_accounts, live_oauth, live_kc)

    # Restash outgoing live credentials before switching away.
    if (live_oauth or live_kc) and here and here != "unknown" and here != target.get("email"):
        for other in gprof_names():
            if other == name:
                continue
            with open(gprof_path(other)) as f:
                if json.load(f).get("email") == here:
                    gprof_write(other, here, live_oauth, live_kc, live_accounts)
                    print(t("restashed", name=other))
                    break

    if target.get("oauthCreds"):
        gemini_oauth_write(target["oauthCreds"])
    else:
        gemini_oauth_delete()

    if IS_MAC:
        if target.get("keychainCreds"):
            gemini_kc_write(target["keychainCreds"])
        elif live_kc:
            gemini_kc_delete()

    target_email = target.get("email")
    if target_email and target_email != "unknown":
        acc = dict(live_accounts) if isinstance(live_accounts, dict) else {}
        old_list = list(acc.get("old") or [])
        if here and here != "unknown" and here != target_email and here not in old_list:
            old_list.append(here)
        old_list = [e for e in old_list if e != target_email]
        acc["active"] = target_email
        acc["old"] = old_list
        gemini_accounts_save(acc)
    elif target.get("googleAccounts"):
        gemini_accounts_save(target["googleAccounts"])

    print(t("switched", name=name, email=target.get("email")))
    note = gemini_expiry_note(target.get("oauthCreds"), target.get("keychainCreds"))
    if note:
        print(note)
    if gemini_running():
        print(t("gemini_running"))


def gcmd_list():
    names = gprof_names()
    if not names:
        print(t("gemini_no_profiles"))
        return
    live_accounts = gemini_accounts_load()
    here = gemini_extract_email(live_accounts, gemini_oauth_read(), gemini_kc_read())
    for n in names:
        with open(gprof_path(n)) as f:
            d = json.load(f)
        mark = "*" if d.get("email") == here else " "
        print(f"{mark} {n:<12} {d.get('email'):<34} {t('saved_at', ts=d.get('savedAt'))}")


def gcmd_status():
    oauth_blob = gemini_oauth_read()
    kc_blob = gemini_kc_read()
    accounts = gemini_accounts_load()
    if not oauth_blob and not kc_blob and not accounts.get("active"):
        print(t("not_logged_in"))
        return
    email = gemini_extract_email(accounts, oauth_blob, kc_blob)
    name = t("unsaved")
    for n in gprof_names():
        with open(gprof_path(n)) as f:
            if json.load(f).get("email") == email:
                name = n
                break
    print(t("current", email=email, name=name))
    note = gemini_expiry_note(oauth_blob, kc_blob)
    if note:
        print(note)


def gcmd_rm(name):
    gprof_read(name)
    os.remove(gprof_path(name))
    print(t("removed", name=name))


def gcmd_path():
    kc = (f'macOS Keychain, service "{GEMINI_KC_SERVICE}", account "{GEMINI_KC_ACCOUNT}"'
          if IS_MAC else "(not used on this OS)")
    print(t("gemini_path_report", cfgdir=gemini_config_dir(),
            accfile=gemini_accounts_file(), oauthfile=gemini_oauth_file(),
            kc=kc, profiles=gemini_store()))


def gemini_main(argv):
    if not argv:
        gcmd_status()
        return
    cmd, rest = argv[0], argv[1:]
    force = "--force" in rest or "-f" in rest
    rest = [a for a in rest if a not in ("--force", "-f")]

    if cmd == "save":
        if len(rest) != 1:
            die("needs_arg", cmd=f"gemini {cmd}")
        gcmd_save(rest[0], force)
    elif cmd == "use":
        if len(rest) != 1:
            die("needs_arg", cmd=f"gemini {cmd}")
        gcmd_use(rest[0])
    elif cmd in ("rm", "remove"):
        if len(rest) != 1:
            die("needs_arg", cmd=f"gemini {cmd}")
        gcmd_rm(rest[0])
    elif cmd in ("list", "ls"):
        gcmd_list()
    elif cmd in ("status", "current"):
        gcmd_status()
    elif cmd == "path":
        gcmd_path()
    elif cmd in ("version", "--version", "-V"):
        print(f"ccauth {VERSION}")
    elif cmd in ("help", "--help", "-h"):
        print(t("gemini_usage", version=VERSION))
    elif NAME_RE.match(cmd) and not rest:
        gcmd_use(cmd)
    else:
        print(t("gemini_usage", version=VERSION))
        sys.exit(1)


# --------------------------------------------------------------------------
# Antigravity support (agy CLI and the Antigravity desktop app)
# --------------------------------------------------------------------------
#
# Two modes.
#   official    The Google sign-in that Antigravity already holds. ccauth only
#               saves a copy of that session so it can be restored.
#   <provider>  A third-party Gemini-compatible relay (base URL + key). The
#               Google session is left in place but is not used for model
#               calls:
#                 * agy runs in its GEMINI_API_KEY mode (no sign-in at all),
#                   pointed at a local bridge on 127.0.0.1.
#                 * The desktop app has no API-key mode, so it is started with
#                   CLOUD_CODE_URL pointing at the same bridge. The bridge
#                   answers the app's account calls from a local cache and
#                   sends generation requests to the relay. The Google token
#                   and project id are never forwarded to the relay.
#                 * Both get an installation_id private to the provider; the
#                   official ids are restored on switching back.
# The bridge also renames models: the app asks for e.g. gemini-4-argon-low
# while a relay may only list gemini-4-argon-high.

import uuid
import urllib.error
import urllib.request

AGY_PORT = int(os.environ.get("CCAUTH_AGY_PORT", "18765"))
AGY_LABEL = "io.github.qzkinhit.ccauth-agy"
AGY_KC_SERVICE = "gemini"
AGY_KC_ACCOUNT = "antigravity"
AGY_LOCAL_KEY = "ccauth-local-bridge"
AGY_GEN_OPS = ("streamGenerateContent", "generateContent", "countTokens")
AGY_LEVELS = ["xhigh", "high", "medium", "low"]


def tt(en, zh):
    return zh if LANG == "zh" else en


def agy_die(en, zh):
    print("ccauth: " + tt(en, zh), file=sys.stderr)
    sys.exit(1)


def agy_store():
    return os.path.join(STORE, "agy")


def agy_state_file():
    return os.path.join(agy_store(), "state.json")


def agy_provider_dir():
    return os.path.join(agy_store(), "providers")


def agy_cache_dir():
    return os.path.join(agy_store(), "cache")


def agy_cli_dir():
    return os.path.join(HOME, ".gemini", "antigravity-cli")


def agy_app_dir():
    return os.path.join(HOME, ".gemini", "antigravity")


def agy_cli_settings():
    return os.path.join(agy_cli_dir(), "settings.json")


def agy_env_file():
    return os.path.join(agy_store(), "env.sh")


def agy_plist():
