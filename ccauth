def acmd_add(name, url, key, models=None, default=None, force=False):
    path = agy_provider_path(name)
    if os.path.exists(path) and not force:
        agy_die(f"Provider {name} already exists. Pass --force to overwrite.",
                f"第三方 {name} 已存在，加 --force 覆盖")
    if not url or not key:
        agy_die("add needs --url and --key", "add 需要 --url 和 --key")
    if not url.startswith("http"):
        url = "https://" + url
    if not models:
        try:
            models = agy_fetch_models(url, key)
        except Exception as e:
            agy_die(f"Could not list models at {url}: {e}. Pass --models a,b to skip this.",
                    f"无法从 {url} 读取模型列表（{e}），可以用 --models a,b 手动指定")
    if not models:
        agy_die("The relay lists no gemini-* models.", "该中转站没有 gemini 开头的模型")
    default = default or next((m for m in models if "argon" in m), models[0])
    os.makedirs(agy_provider_dir(), exist_ok=True)
    _write_private(path, json.dumps({"name": name, "url": url.rstrip("/"), "key": key,
                                     "models": models, "default": default,
                                     "savedAt": datetime.now().astimezone().isoformat(timespec="seconds")},
                                    indent=2))
    print(tt(f"Saved provider {name} -> {url}", f"已保存第三方 {name} -> {url}"))
    print(tt("  models: ", "  可用模型 ") + ", ".join(models))
    print(tt(f"  Switch with: ccauth agy use {name}", f"  切换命令 ccauth agy use {name}"))


def acmd_use(name):
    if name == "official":
        return acmd_use_official()
    prov = agy_provider(name)
    if not IS_MAC:
        agy_die("Third-party mode for Antigravity is implemented for macOS only.",
                "Antigravity 第三方模式目前只支持 macOS")
    st = agy_state()
    if st.get("active", "official") == "official":
        agy_save_session(quiet=True)
    agy_ids_apply(name)
    agy_cli_model_provider(True)
    agy_write_env(True)
    hooked = agy_install_hook()
    st = agy_state()
    st["active"] = name
    agy_state_save(st)
    agy_service_start()
    for _ in range(20):
        if agy_bridge_alive():
            break
        time.sleep(0.25)
    print(tt(f"Switched Antigravity to {name} ({prov['url']})",
             f"Antigravity 已切到第三方 {name}（{prov['url']}）"))
    if not agy_bridge_alive():
