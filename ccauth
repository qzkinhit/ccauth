def _opt(rest, flag):
    if flag in rest:
        i = rest.index(flag)
        if i + 1 < len(rest):
            val = rest[i + 1]
            del rest[i:i + 2]
            return val
        del rest[i]
    for i, a in enumerate(rest):
        if a.startswith(flag + "="):
            del rest[i]
            return a.split("=", 1)[1]
    return None


def agy_main(argv):
    if not argv:
        return acmd_status()
    cmd, rest = argv[0], list(argv[1:])
    force = "--force" in rest or "-f" in rest
    rest = [a for a in rest if a not in ("--force", "-f")]
    if cmd == "add":
        url, key = _opt(rest, "--url"), _opt(rest, "--key")
        models = _opt(rest, "--models")
        default = _opt(rest, "--default")
        if len(rest) != 1:
            die("needs_arg", cmd="agy add")
        acmd_add(rest[0], url, key, [m.strip() for m in models.split(",")] if models else None,
                 default, force)
    elif cmd == "use":
        if len(rest) == 2 and rest[0] == "official":
            acmd_use(rest[0], rest[1])
        elif len(rest) != 1:
            die("needs_arg", cmd="agy use")
        else:
            acmd_use(rest[0])
    elif cmd in ("accounts", "officials"):
        acmd_accounts()
    elif cmd == "forget":
        if len(rest) != 1:
            die("needs_arg", cmd="agy forget")
        acmd_forget(rest[0])
    elif cmd in ("rm", "remove"):
        if len(rest) != 1:
            die("needs_arg", cmd="agy rm")
        acmd_rm(rest[0])
    elif cmd == "cheap":
        if len(rest) != 2:
            die("needs_arg", cmd="agy cheap <name> <model|off>")
        acmd_cheap(rest[0], rest[1])
    elif cmd == "writing":
        if len(rest) != 2:
            die("needs_arg", cmd="agy writing <name> <on|off>")
        acmd_writing(rest[0], rest[1])
    elif cmd == "login":
        if len(rest) != 2:
            die("needs_arg", cmd="agy login <name> <username>")
        acmd_login(rest[0], rest[1])
    elif cmd == "site":
        if len(rest) not in (3, 4, 5):
            die("needs_arg", cmd="agy site <name> <url> <username> [user_id] [access_token]")
        if len(rest) == 3:
            rest = rest + [""]
        acmd_site(rest[0], rest[1], rest[2], rest[3], rest[4] if len(rest) == 5 else "")
    elif cmd == "checkin":
        if "--install" in rest:
            agy_checkin_install(True)
        elif "--uninstall" in rest:
            agy_checkin_install(False)
        else:
            sys.exit(0 if agy_checkin_all([a for a in rest if not a.startswith("-")] or None,
                                          force_all=bool([a for a in rest if not a.startswith("-")])) else 1)
    elif cmd in ("models", "refresh"):
        acmd_models([a for a in rest if not a.startswith("-")])
    elif cmd in ("quota", "balance"):
        if "--json" in rest:
            gui_print_quota()
        else:
            acmd_quota()
    elif cmd == "writer":
        if len(rest) != 2:
            die("needs_arg", cmd="agy writer <name> <model|off>")
        acmd_writer(rest[0], rest[1])
    elif cmd == "fallback":
        if len(rest) != 2:
            die("needs_arg", cmd="agy fallback <name> <other|off>")
        acmd_fallback(rest[0], rest[1])
    elif cmd == "hint":
        if len(rest) != 2:
            die("needs_arg", cmd="agy hint <name> <on|off|text>")
        acmd_hint(rest[0], rest[1])
    elif cmd == "save":
        agy_save_session(name=rest[0] if rest else None)
    elif cmd in ("list", "ls"):
        acmd_list()
    elif cmd in ("status", "current"):
        acmd_status()
    elif cmd == "path":
        acmd_path()
    elif cmd == "bridge":
        agy_bridge()
    elif cmd in ("help", "--help", "-h"):
        print(AGY_USAGE[LANG].format(version=VERSION))
    elif (cmd == "official" or NAME_RE.match(cmd)) and not rest:
        acmd_use(cmd)
    else:
        print(AGY_USAGE[LANG].format(version=VERSION))
        sys.exit(1)


# --------------------------------------------------------------------------
# Codex: Gemini main agent on a relay, subagents on the provider CC Switch picked
# --------------------------------------------------------------------------
#
# Codex sends every request of one session to one provider, main agent and
# subagents alike, and a role file cannot change the provider. ccauth therefore
# points that provider at a local router that splits by model name:
#   gemini-*  -> a relay saved with `ccauth agy add` (its key, its fallbacks);
#                developer/system text is neutralised first, because some
#                relays reject a system prompt that introduces itself as Codex
#   anything  -> the upstream CC Switch last wrote into ~/.codex/config.toml,
#                with the request's own Authorization header
# A launchd watcher re-applies the edit each time CC Switch rewrites the file.

CODEX_PORT = int(os.environ.get("CCAUTH_CODEX_PORT", "18766"))
CODEX_ROUTER_LABEL = "io.github.qzkinhit.ccauth-codex"
CODEX_SYNC_LABEL = "io.github.qzkinhit.ccauth-codex-sync"
CODEX_ROUTER_URL = f"http://127.0.0.1:{CODEX_PORT}/v1"
CODEX_DEFAULTS = {"main": "gemini-4-neon-xhigh", "subagent": "gpt-6.1-sol", "relay": "wududu",
                  "subagent_effort": "max",
                  "fallback_models": ["gemini-4-hydrogen-xhigh", "gemini-3.8-flash-high"]}
CODEX_EFFORTS = ("max", "xhigh", "high", "medium", "low")   # strongest first; an upstream refusal steps down
CODEX_BACKGROUND = ("luna",)   # Codex's own background model keeps the effort Codex chose
CODEX_SPAWN_HEADER = ("x-openai-subagent", "collab_spawn")   # what Codex sends for a spawned subagent


def codex_effort(st):
    """The reasoning effort subagents run at, or None to leave it to Codex."""
    e = str(st.get("subagent_effort") or "").strip().lower()
    return e if e in CODEX_EFFORTS else None


def codex_store():
    return os.path.join(STORE, "codex")


def codex_state_file():
    return os.path.join(codex_store(), "state.json")


def codex_state():
    st = dict(CODEX_DEFAULTS)
    st.update(_read_json(codex_state_file(), {}) or {})
    return st


def codex_state_save(st):
    os.makedirs(codex_store(), exist_ok=True)
    os.chmod(STORE, 0o700)
    _write_private(codex_state_file(), json.dumps(st, indent=2))


def codex_config_path():
    return os.environ.get("CCAUTH_CODEX_CONFIG") or os.path.join(
        os.environ.get("CODEX_HOME") or os.path.join(HOME, ".codex"), "config.toml")


# ---- minimal line-based TOML editing (keeps the rest of the file intact) ----

def _toml_quote(v):
    return '"' + str(v).replace("\\", "\\\\").replace('"', '\\"') + '"'


def _toml_sections(lines):
    """[(header or None, start, end)] where lines[start:end] belong to the section."""
    out, cur, start = [], None, 0
    for i, ln in enumerate(lines):
        s = ln.strip()
        if s.startswith("[") and not s.startswith("[["):
            out.append((cur, start, i))
            cur, start = s, i + 1
    out.append((cur, start, len(lines)))
    return out


def _toml_get(lines, header, key):
    for h, a, b in _toml_sections(lines):
        if h == header:
            for ln in lines[a:b]:
                m = re.match(r"\s*" + re.escape(key) + r"\s*=\s*(.+?)\s*$", ln)
                if m:
                    v = m.group(1)
                    if v.startswith('"'):
                        m2 = re.match(r'"((?:[^"\\]|\\.)*)"', v)
                        return m2.group(1) if m2 else v.strip('"')
                    return v
    return None


def _toml_set(lines, header, key, value):
    """Set key = "value" in the section `header` (None = top level). Returns new lines."""
    lines = list(lines)
    secs = _toml_sections(lines)
    for h, a, b in secs:
        if h == header:
            for i in range(a, b):
                if re.match(r"\s*" + re.escape(key) + r"\s*=", lines[i]):
                    lines[i] = f"{key} = {_toml_quote(value)}"
                    return lines
            lines.insert(a if header else 0, f"{key} = {_toml_quote(value)}")
            return lines
    lines += ["", header, f"{key} = {_toml_quote(value)}"]
    return lines


def _toml_del(lines, header, key):
    out, cur = [], None
    for ln in lines:
        s = ln.strip()
        if s.startswith("[") and not s.startswith("[["):
            cur = s
        if cur == header and re.match(r"\s*" + re.escape(key) + r"\s*=", ln):
            continue
        out.append(ln)
    return out


# ---- sync: re-apply the routing after CC Switch writes the file ----

def codex_catalog_path():
    return os.path.join(codex_store(), "model-catalog.json")


def codex_request_log():
    return os.path.join(codex_store(), "requests.jsonl")


def codex_catalog_entries(path):
    try:
        d = _read_json(path, {}) or {}
        return [m for m in (d.get("models") or []) if isinstance(m, dict) and m.get("slug")]
    except Exception:
        return []


def codex_write_catalog(st):
    """A model catalog for the Codex picker: the relay's Gemini models, then the subagent models."""
    home = os.path.dirname(codex_config_path())
    cache = codex_catalog_entries(os.path.join(home, "models_cache.json"))
    orig = codex_catalog_entries(st["orig_catalog"]) if st.get("orig_catalog") else []
    ccs = codex_catalog_entries(os.path.join(home, "cc-switch-model-catalog.json"))
    template = (cache or orig or ccs or [None])[0]
    if template is None:
        return None
    prov = _read_json(os.path.join(agy_provider_dir(), st["relay"] + ".json"), {}) or {}
    order = {fam: i for i, fam in enumerate(AGY_MODEL_PREFERENCE)}
    gem = sorted([m for m in prov.get("models") or [] if m.lower().startswith("gemini")],
                 key=lambda m: order.get(_family(m), 99))
    if st["main"] not in gem:
        gem.insert(0, st["main"])
    subs = []
    for m in [st["subagent"] if st["subagent"] != "follow" else None, st.get("ccswitch_model")] + \
             [e["slug"] for e in orig + ccs]:
        if m and m not in subs and m not in gem:
            subs.append(m)
    known = {e["slug"]: e for e in cache + orig + ccs}
    out = []
    for i, slug in enumerate(gem + subs):
        e = json.loads(json.dumps(known.get(slug) or template))
        e["slug"] = slug
        e["visibility"] = "list"
        e["priority"] = i
        if slug in gem:
            e["display_name"] = slug
            e["description"] = tt(f"Gemini via {st['relay']} (ccauth)", f"经 {st['relay']} 的 Gemini（ccauth 分流）")
            if isinstance(e.get("base_instructions"), str):
                e["base_instructions"] = codex_neutralise(e["base_instructions"])
            e.pop("upgrade", None)
        elif slug not in known:
            e["display_name"] = slug
            e["description"] = tt("Subagent model on the CC Switch provider", "子代理模型，经 CC Switch 选中的服务商")
        out.append(e)
    path = codex_catalog_path()
    data = json.dumps({"models": out}, ensure_ascii=False, indent=1)
    if _read_text(path) != data:
        _write_private(path, data)
    return path


def codex_sync(quiet=False, force=False):
    """Re-apply the routing. The model is reset to the main model only when CC Switch rewrote the
    provider (base_url no longer points at the router) or force is set; a model picked in Codex stays."""
    st = codex_state()
    if not st.get("enabled"):
        return False
    path = codex_config_path()
    try:
        with open(path) as f:
            text = f.read()
    except OSError:
        return False
    lines = text.split("\n")
    prov = _toml_get(lines, None, "model_provider") or "custom"
    header = f"[model_providers.{prov}]"
    base = _toml_get(lines, header, "base_url")
    changed_state = False
    rewritten = bool(base) and base.rstrip("/") != CODEX_ROUTER_URL
    if rewritten:
        if st.get("upstream") != base:
            st["upstream"] = base
            changed_state = True
        lines = _toml_set(lines, header, "base_url", CODEX_ROUTER_URL)
    model = _toml_get(lines, None, "model")
    if rewritten and model and model != st["main"] and not model.lower().startswith("gemini"):
        if st.get("ccswitch_model") != model:
            st["ccswitch_model"] = model
            changed_state = True
    if (rewritten or force or not model) and model != st["main"]:
        lines = _toml_set(lines, None, "model", st["main"])
    sub = st.get("ccswitch_model") if st["subagent"] == "follow" else st["subagent"]
    if sub and _toml_get(lines, "[agents]", "default_subagent_model") != sub:
        lines = _toml_set(lines, "[agents]", "default_subagent_model", sub)
    eff = codex_effort(st)
    cur_eff = _toml_get(lines, "[agents]", "default_subagent_reasoning_effort")
    if eff and cur_eff != eff:
        if cur_eff and "orig_subagent_effort" not in st:
            st["orig_subagent_effort"] = cur_eff
            changed_state = True
        lines = _toml_set(lines, "[agents]", "default_subagent_reasoning_effort", eff)
    if _toml_get(lines, None, "default_subagent_reasoning_effort") is not None:
        # Codex only reads this key under [agents]; at the top level it is ignored with a warning.
        lines = _toml_del(lines, None, "default_subagent_reasoning_effort")
    cat_now = _toml_get(lines, None, "model_catalog_json")
    if cat_now and cat_now != codex_catalog_path() and st.get("orig_catalog") != cat_now:
        st["orig_catalog"] = cat_now
        changed_state = True
    if not cat_now and st.get("orig_catalog"):
        st["orig_catalog"] = None
        changed_state = True
    if changed_state:
        codex_state_save(st)
    cat = codex_write_catalog(st)
    if cat and cat_now != cat:
        lines = _toml_set(lines, None, "model_catalog_json", cat)
    new = "\n".join(lines)
    if new != text:
        tmp = path + ".ccauth-tmp"
        with open(tmp, "w") as f:
            f.write(new)
        os.replace(tmp, path)
        if not quiet:
            print(time.strftime("%Y-%m-%d %H:%M:%S"), "codex config re-applied", flush=True)
        return True
    return False


def codex_restore():
    st = codex_state()
    path = codex_config_path()
    try:
        with open(path) as f:
            lines = f.read().split("\n")
    except OSError:
        return
    prov = _toml_get(lines, None, "model_provider") or "custom"
    header = f"[model_providers.{prov}]"
    if st.get("upstream") and (_toml_get(lines, header, "base_url") or "").rstrip("/") == CODEX_ROUTER_URL:
        lines = _toml_set(lines, header, "base_url", st["upstream"])
    if st.get("ccswitch_model") and _toml_get(lines, None, "model") == st["main"]:
        lines = _toml_set(lines, None, "model", st["ccswitch_model"])
    lines = _toml_del(lines, "[agents]", "default_subagent_model")
    if codex_effort(st) and _toml_get(lines, "[agents]", "default_subagent_reasoning_effort") == codex_effort(st):
        if st.get("orig_subagent_effort"):
            lines = _toml_set(lines, "[agents]", "default_subagent_reasoning_effort", st["orig_subagent_effort"])
        else:
            lines = _toml_del(lines, "[agents]", "default_subagent_reasoning_effort")
    if _toml_get(lines, None, "model_catalog_json") == codex_catalog_path():
        if st.get("orig_catalog"):
            lines = _toml_set(lines, None, "model_catalog_json", st["orig_catalog"])
        else:
            lines = _toml_del(lines, None, "model_catalog_json")
    tmp = path + ".ccauth-tmp"
    with open(tmp, "w") as f:
        f.write("\n".join(lines))
    os.replace(tmp, path)


# ---- the router ----

def codex_neutralise(text):
    text = re.sub(r"OpenAI Codex", "the coding agent", text)
    text = re.sub(r"\bCodex\b", "the coding agent", text)
    return re.sub(r"\bOpenAI\b", "the vendor", text)


def codex_clean_for_relay(body):
    if isinstance(body.get("instructions"), str):
        body["instructions"] = codex_neutralise(body["instructions"])
    for it in body.get("input") or []:
        if isinstance(it, dict) and it.get("role") in ("developer", "system"):
            for c in it.get("content") or []:
                if isinstance(c, dict) and isinstance(c.get("text"), str):
                    c["text"] = codex_neutralise(c["text"])
    return body


def codex_user_text(body):
    """The newest thing the user typed, for the request log."""
    for it in reversed(body.get("input") or []):
        if not isinstance(it, dict) or it.get("role") != "user":
            continue
        for c in it.get("content") or []:
            t = c.get("text") if isinstance(c, dict) else None
            if isinstance(t, str) and t.strip() and not t.lstrip().startswith("<"):
                return t.strip()
    return ""


CODEX_ALIASES = {}
CODEX_UNSUPPORTED_SECONDS = 1800
CODEX_COOLDOWN_SECONDS = 180


def codex_router():
    from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
    import threading

    lock = threading.Lock()
    cooled = {}
    unsupported = {}
    effort_cap = {}   # (upstream, model) -> (strongest effort it accepted, until)

    def log(*a):
        with lock:
            print(time.strftime("%Y-%m-%d %H:%M:%S"), *a, flush=True)

    def record(rec):
        line = json.dumps(rec, ensure_ascii=False) + "\n"
        path = codex_request_log()
        with lock:
            try:
                if os.path.exists(path) and os.path.getsize(path) > 5 * 1024 * 1024:
                    os.replace(path, path + ".1")
                with open(path, "a", encoding="utf-8") as f:
                    f.write(line)
            except OSError:
                pass

    direct = urllib.request.build_opener(urllib.request.ProxyHandler({}))
    px = os.environ.get("HTTPS_PROXY") or os.environ.get("https_proxy")
    proxied = urllib.request.build_opener(urllib.request.ProxyHandler({"http": px, "https": px} if px else {}))

    def code_of(r):
        return getattr(r, "status", None) or r.code

    def sub_model(st):
        return st.get("ccswitch_model") if st["subagent"] == "follow" else st["subagent"]

    class Handler(BaseHTTPRequestHandler):
        protocol_version = "HTTP/1.1"

        def log_message(self, *a):
            pass

        def send_json(self, code, obj):
            data = json.dumps(obj).encode()
            self.send_response(code)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(data)))
            self.end_headers()
            self.wfile.write(data)

        def do_GET(self):
            if self.path.startswith("/ccauth/health"):
                return self.send_json(200, {"ok": True})
            self.route(b"")

        def do_POST(self):
            n = int(self.headers.get("Content-Length") or 0)
            self.route(self.rfile.read(n) if n else b"")

        def pipe(self, r, rec):
            """Stream the reply through and note the text and token usage for the log."""
            self.send_response(code_of(r))
            for k, v in r.headers.items():
                if k.lower() not in ("content-length", "transfer-encoding", "connection", "content-encoding"):
                    self.send_header(k, v)
            self.send_header("Transfer-Encoding", "chunked")
            self.end_headers()
            buf, reply, first = b"", [], True
            sse = "event-stream" in (r.headers.get("Content-Type") or "")
            whole = []
            while True:
                chunk = r.read1(65536) if hasattr(r, "read1") else r.read(65536)
                if not chunk:
                    break
                if first:
                    rec["ttfb_ms"] = int((time.time() - rec["_t0"]) * 1000)
                    first = False
                self.wfile.write(b"%x\r\n%s\r\n" % (len(chunk), chunk))
                self.wfile.flush()
                if sse:
                    buf += chunk
                    *lines, buf = buf.split(b"\n")
                    for ln in lines:
                        self.note_event(ln, rec, reply)
                elif sum(len(c) for c in whole) < 400000:
                    whole.append(chunk)
            self.wfile.write(b"0\r\n\r\n")
            if not sse and whole:
                try:
                    obj = json.loads(b"".join(whole))
                    for o in obj.get("output") or []:
                        for c in o.get("content") or []:
                            if c.get("type") == "output_text":
                                reply.append(c.get("text") or "")
                    self.note_usage(obj.get("usage"), rec)
                except ValueError:
                    pass
            rec["reply"] = "".join(reply)[:300]

        @staticmethod
        def note_usage(u, rec):
            if isinstance(u, dict):
                rec["in_tokens"] = u.get("input_tokens")
                rec["out_tokens"] = u.get("output_tokens")

        def note_event(self, ln, rec, reply):
            ln = ln.strip()
            if not ln.startswith(b"data:"):
                return
            try:
                ev = json.loads(ln[5:].strip() or b"{}")
            except ValueError:
                return
            t = ev.get("type") or ""
            if t == "response.output_text.delta" and sum(len(x) for x in reply) < 300:
                reply.append(ev.get("delta") or "")
            elif t in ("response.completed", "response.done", "response.incomplete"):
                self.note_usage((ev.get("response") or {}).get("usage"), rec)
            elif t in ("response.failed", "error"):
                err = (ev.get("response") or {}).get("error") or ev.get("error") or ev
                rec["error"] = json.dumps(err, ensure_ascii=False)[:300]
                rec["ok"] = False

        def send_raw(self, code, raw, ctype):
            self.send_response(code)
            self.send_header("Content-Type", ctype or "application/json")
            self.send_header("Content-Length", str(len(raw)))
            self.end_headers()
            self.wfile.write(raw)

        def open(self, opener, url, body, hdr):
            req = urllib.request.Request(url, data=body if self.command == "POST" else None,
                                         headers=hdr, method=self.command)
            try:
                return opener.open(req, timeout=1800)
            except urllib.error.HTTPError as e:
                return e

        def route(self, body):
            st = codex_state()
            try:
                j = json.loads(body) if body else {}
            except ValueError:
                j = {}
            model = j.get("model") or ""
            rec = {"ts": datetime.now().astimezone().isoformat(timespec="seconds"), "_t0": time.time(),
                   "path": self.path.split("?")[0], "asked": model, "model": model, "route": "", "tries": [],
                   "ok": None, "status": None, "user": codex_user_text(j)[:200] if j else "",
                   "agent": self.headers.get(CODEX_SPAWN_HEADER[0]) or ""}
            hdr = {k: v for k, v in self.headers.items()
                   if k.lower() not in ("host", "content-length", "accept-encoding", "connection")}
            try:
                if model.lower().startswith("gemini"):
                    self.to_relay(st, j, hdr, rec)
                else:
                    self.to_upstream(st, j, body, hdr, rec)
            except (BrokenPipeError, ConnectionResetError):
                rec["error"] = (rec.get("error") or "") + " client closed"
                log("client closed", model)
            finally:
                rec["ms"] = int((time.time() - rec.pop("_t0")) * 1000)
                if rec["ok"] is None:
                    rec["ok"] = rec["status"] == 200
                if self.command == "POST":
                    record(rec)

        def to_upstream(self, st, j, body, hdr, rec):
            up = (st.get("upstream") or "").rstrip("/")
            rec["route"] = "upstream"
            if not up:
                rec["status"] = 502
                return self.send_json(502, {"error": {"message": "ccauth codex: no upstream recorded yet"}})
            path = self.path[3:] if self.path.startswith("/v1") and up.endswith("/v1") else self.path
            model = j.get("model") or ""
            alias = CODEX_ALIASES.get(model)
            if alias:
                model = sub_model(st) if alias == "@subagent" else alias
            tries = [model] if model else [""]
            sub = sub_model(st)
            if sub and model and sub != model:
                if unsupported.get((up, model), 0) > time.time():
                    tries = [sub]
                    rec["note"] = tt(f"{model} is not offered by this provider; using {sub}",
                                     f"当前服务商不支持 {model}，改用 {sub}")
                else:
                    tries.append(sub)
            # Spawned subagents run at the configured effort, whatever the spawning agent asked for.
            # A model picked in Codex itself carries no subagent header and keeps its own effort.
            spawned = (self.headers.get(CODEX_SPAWN_HEADER[0]) or "") == CODEX_SPAWN_HEADER[1]
            want = codex_effort(st) if (spawned and j and self.command == "POST" and "/responses" in path and
                                        not any(b in (j.get("model") or "").lower() for b in CODEX_BACKGROUND)) else None
            if want:
                rec["effort_asked"] = (j.get("reasoning") or {}).get("effort")
            dirty, i = False, 0
            while i < len(tries):
                m = tries[i]
                if m and m != j.get("model"):
                    j["model"] = m
                    dirty = True
                if want:
                    eff = want
                    cap = effort_cap.get((up, m))
                    if cap and cap[1] > time.time() and CODEX_EFFORTS.index(cap[0]) > CODEX_EFFORTS.index(eff):
                        eff = cap[0]
                    if (j.get("reasoning") or {}).get("effort") != eff:
                        j["reasoning"] = dict(j.get("reasoning") or {}, effort=eff)
                        dirty = True
                    rec["effort"] = eff
                if dirty:
                    body = json.dumps(j).encode()
                    dirty = False
                r = self.open(proxied, up + path, body, hdr)
                code = code_of(r)
                rec["tries"].append([m or "-", code])
                rec["model"], rec["status"] = m, code
                if code in (400, 404):
                    raw = r.read()
                    low = raw.lower()
                    cur = (j.get("reasoning") or {}).get("effort")
                    if want and code == 400 and b"effort" in low and cur in CODEX_EFFORTS[:-1]:
                        nxt = CODEX_EFFORTS[CODEX_EFFORTS.index(cur) + 1]
                        effort_cap[(up, m)] = (nxt, time.time() + CODEX_UNSUPPORTED_SECONDS)
                        rec["note"] = raw[:200].decode("utf-8", "replace")
                        log("upstream", m, "effort", cur, "refused -> retry with", nxt)
                        continue
                    if i + 1 < len(tries) and (m.encode() in raw or b"model" in low or "模型".encode() in raw):
                        unsupported[(up, m)] = time.time() + CODEX_UNSUPPORTED_SECONDS
                        rec["note"] = raw[:200].decode("utf-8", "replace")
                        log("upstream", m, code, "not offered -> retry with", tries[i + 1])
                        i += 1
                        continue
                    rec["error"] = raw[:300].decode("utf-8", "replace")
                    log("upstream", self.command, rec["path"], m or "-", code)
                    return self.send_raw(code, raw, r.headers.get("Content-Type"))
                log("upstream", self.command, rec["path"], m or "-", code)
                if code != 200:
                    raw = r.read()
                    rec["error"] = raw[:300].decode("utf-8", "replace")
                    return self.send_raw(code, raw, r.headers.get("Content-Type"))
                return self.pipe(r, rec)

        def to_relay(self, st, j, hdr, rec):
            prov = _read_json(os.path.join(agy_provider_dir(), st["relay"] + ".json"))
            if not prov:
                rec["status"] = 502
                return self.send_json(502, {"error": {"message": f"ccauth codex: relay {st['relay']} not found"}})
            codex_clean_for_relay(j)
            try:
                agy_refresh_models(prov)
            except Exception:
                pass
            path = self.path[3:] if self.path.startswith("/v1") else self.path
            models = [j["model"]] + [m for m in st.get("fallback_models") or [] if m != j["model"]]
            now = time.time()
            models = [m for m in models if cooled.get(m, 0) <= now] + [m for m in models if cooled.get(m, 0) > now]
            chain = agy_chain(prov)
            last = None
            for cand in chain:
                rec["route"] = cand["name"]
                for m in models:
                    j["model"] = m
                    h = dict(hdr)
                    h["Authorization"] = "Bearer " + cand["key"]
                    r = self.open(direct, cand["url"].rstrip("/") + "/v1" + path, json.dumps(j).encode(), h)
                    code = code_of(r)
                    rec["tries"].append([m, code])
                    rec["model"], rec["status"] = m, code
                    if code == 200:
                        log("relay", cand["name"], m, 200)
                        cooled.pop(m, None)
                        if agy_exhausted(cand["name"]):
                            agy_mark_exhausted(cand["name"], False)
                        return self.pipe(r, rec)
                    raw = r.read()
                    last = (code, raw)
                    low = raw.decode("utf-8", "replace").lower()
                    rec["error"] = raw[:300].decode("utf-8", "replace")
                    log("relay", cand["name"], m, code, raw[:160])
                    if agy_key_exhausted(code, raw):
                        agy_mark_exhausted(cand["name"], True)
                        break
                    if code in (429, 503, 404) and any(w in low for w in
                                                       ("cooling down", "exhausted", "no available channel",
                                                        "model_not_found", "无可用渠道")):
                        cooled[m] = time.time() + CODEX_COOLDOWN_SECONDS
                        continue
                    return self.send_json(code, json.loads(raw) if raw.startswith(b"{") else
                                          {"error": {"message": rec["error"]}})
            code, raw = last or (502, b'{"error":{"message":"ccauth codex: relay failed"}}')
            rec["status"] = code
            self.send_response(code)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(raw)))
            self.end_headers()
            self.wfile.write(raw)

    def refresher():
        while True:
            try:
                for n, (added, removed, _m, err) in agy_refresh_all_models().items():
                    if added or removed:
                        log("models", n, "added", added, "removed", removed)
            except Exception as e:  # noqa: BLE001
                log("model refresh failed", repr(e))
            time.sleep(AGY_MODELS_TTL)

    threading.Thread(target=refresher, daemon=True).start()
    log("codex router listening on", CODEX_PORT)
    ThreadingHTTPServer(("127.0.0.1", CODEX_PORT), Handler).serve_forever()


def codex_log_lines(n):
    path = codex_request_log()
    try:
        with open(path, encoding="utf-8") as f:
            lines = f.readlines()[-n:]
    except OSError:
        return []
    out = []
    for ln in lines:
        try:
            out.append(json.loads(ln))
        except ValueError:
            pass
    return out


def codex_log_format(r):
    tries = " > ".join(f"{m}:{c}" for m, c in r.get("tries") or [])
    tok = ""
    if r.get("in_tokens") is not None:
        tok = f" {r.get('in_tokens')}/{r.get('out_tokens')} tok"
    agent = r.get("agent")
    who = "" if not agent else (tt("subagent ", "子代理 ") if agent == CODEX_SPAWN_HEADER[1] else agent + " ")
    head = (f"{(r.get('ts') or '')[11:19]} {'OK ' if r.get('ok') else 'ERR'} {r.get('route') or '-':<10} {who}"
            f"{r.get('asked') or '-'}" + (f" -> {r.get('model')}" if r.get("model") != r.get("asked") else "") +
            f"  {r.get('ms', 0) / 1000:.1f}s{tok}  [{tries}]")
    if r.get("effort"):
        a = r.get("effort_asked")
        head += "  " + tt("effort ", "强度 ") + (f"{a}->{r['effort']}" if a and a != r["effort"] else r["effort"])
    lines = [head]
    if r.get("user"):
        lines.append("    " + tt("asked: ", "提问：") + r["user"].replace("\n", " ")[:160])
    if r.get("reply"):
        lines.append("    " + tt("reply: ", "回复：") + r["reply"].replace("\n", " ")[:160])
    if r.get("note"):
        lines.append("    " + tt("note: ", "说明：") + r["note"].replace("\n", " ")[:200])
    if r.get("error") and not r.get("ok"):
        lines.append("    " + tt("error: ", "错误：") + r["error"].replace("\n", " ")[:200])
    return "\n".join(lines)


def ccmd_log(rest):
    n = int(_opt(rest, "-n") or 30)
    if "--json" in rest:
        print(json.dumps(codex_log_lines(n), ensure_ascii=False))
        return
    for r in codex_log_lines(n):
        print(codex_log_format(r))
    if "-f" in rest or "--follow" in rest:
        path = codex_request_log()
        pos = os.path.getsize(path) if os.path.exists(path) else 0
        try:
            while True:
                time.sleep(1)
                if not os.path.exists(path):
                    continue
                size = os.path.getsize(path)
                if size < pos:
                    pos = 0
                if size > pos:
                    with open(path, encoding="utf-8") as f:
                        f.seek(pos)
                        for ln in f:
                            try:
                                print(codex_log_format(json.loads(ln)), flush=True)
                            except ValueError:
                                pass
                        pos = f.tell()
        except KeyboardInterrupt:
            pass


# ---- launchd ----

def codex_plist(label):
    return os.path.join(HOME, "Library", "LaunchAgents", label + ".plist")


def codex_install(on):
    uid = str(os.getuid())
    for label in (CODEX_ROUTER_LABEL, CODEX_SYNC_LABEL):
        subprocess.run(["launchctl", "bootout", f"gui/{uid}/{label}"], capture_output=True)
        if not on and os.path.exists(codex_plist(label)):
            os.remove(codex_plist(label))
    if not on:
        return
    py = sys.executable or "/usr/bin/python3"
    log = os.path.join(codex_store(), "router.log")
    px = system_https_proxy()
    common = (f"<key>EnvironmentVariables</key><dict><key>CCAUTH_HOME</key><string>{STORE}</string>"
              f"<key>HTTPS_PROXY</key><string>{px}</string></dict>"
              f"<key>StandardOutPath</key><string>{log}</string><key>StandardErrorPath</key><string>{log}</string>")
    head = ('<?xml version="1.0" encoding="UTF-8"?>\n<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" '
            '"http://www.apple.com/DTDs/PropertyList-1.0.dtd">\n<plist version="1.0"><dict>')
    router = (f"{head}<key>Label</key><string>{CODEX_ROUTER_LABEL}</string>"
              f"<key>ProgramArguments</key><array><string>{py}</string><string>{agy_script_path()}</string>"
              f"<string>codex</string><string>router</string></array>"
              f"<key>RunAtLoad</key><true/><key>KeepAlive</key><true/>{common}</dict></plist>\n")
    sync = (f"{head}<key>Label</key><string>{CODEX_SYNC_LABEL}</string>"
            f"<key>ProgramArguments</key><array><string>{py}</string><string>{agy_script_path()}</string>"
            f"<string>codex</string><string>sync</string></array>"
            f"<key>WatchPaths</key><array><string>{codex_config_path()}</string></array>"
            f"<key>RunAtLoad</key><true/>{common}</dict></plist>\n")
    os.makedirs(os.path.dirname(codex_plist(CODEX_ROUTER_LABEL)), exist_ok=True)
    for label, body in ((CODEX_ROUTER_LABEL, router), (CODEX_SYNC_LABEL, sync)):
        with open(codex_plist(label), "w") as f:
            f.write(body)
        subprocess.run(["launchctl", "bootstrap", f"gui/{uid}", codex_plist(label)], capture_output=True)


def codex_router_alive():
    try:
        with urllib.request.build_opener(urllib.request.ProxyHandler({})).open(
                f"http://127.0.0.1:{CODEX_PORT}/ccauth/health", timeout=2) as r:
            return r.status == 200
    except Exception:
        return False


# ---- commands ----

def ccmd_on(main_model=None, relay=None):
    if not IS_MAC:
        agy_die("Codex routing is implemented for macOS only.", "Codex 分流目前只支持 macOS")
    if not agy_provider_names():
        agy_die("Save a Gemini relay first: ccauth agy add <name> --url ... --key ...",
                "先用 ccauth agy add 保存一个 Gemini 中转站")
    st = codex_state()
    if main_model:
        st["main"] = main_model
    if relay:
        agy_provider(relay)
        st["relay"] = relay
    path = codex_config_path()
    if os.path.exists(path):
        bak = os.path.join(codex_store(), "config.toml.bak-" + time.strftime("%Y%m%d-%H%M%S"))
        os.makedirs(codex_store(), exist_ok=True)
        with open(path) as src:
            _write_private(bak, src.read())
    st["enabled"] = True
    codex_state_save(st)
    codex_sync(quiet=True, force=True)
    codex_install(True)
    for _ in range(20):
        if codex_router_alive():
            break
        time.sleep(0.25)
    st = codex_state()
    print(tt("Codex: main agent on the Gemini relay, subagents on the CC Switch provider.",
             "Codex 已开启分流：主代理走 Gemini 中转站，子代理走 CC Switch 选中的服务商"))
    ccmd_status(header=False)
    print(tt("  Start a new Codex session (or restart the app) for it to take effect.",
             "  新开 Codex 会话（或重启 Codex 应用）后生效"))


def ccmd_off():
    st = codex_state()
    codex_install(False)
    if st.get("enabled"):
        codex_restore()
    st["enabled"] = False
    codex_state_save(st)
    print(tt("Codex routing turned off; the config is back to what CC Switch wrote.",
             "Codex 分流已关闭，配置恢复为 CC Switch 写入的原样"))


def ccmd_set(key, value):
    value = (value or "").strip()
    if not value:
        agy_die("Model name is empty.", "模型名为空")
    if key == "subagent_effort":
        value = value.lower()
        if value not in CODEX_EFFORTS + ("off",):
            agy_die("Effort must be one of: " + ", ".join(CODEX_EFFORTS + ("off",)),
                    "强度只能是 " + "、".join(CODEX_EFFORTS + ("off",)))
    st = codex_state()
    st[key] = value
    codex_state_save(st)
    if st.get("enabled"):
        codex_sync(quiet=True, force=(key == "main"))
    label = {"subagent": tt("Subagent model", "子代理模型"), "main": tt("Main model", "主代理模型"),
             "subagent_effort": tt("Subagent effort", "子代理强度")}[key]
    shown = (tt("follow CC Switch", "跟随 CC Switch") + f" ({st.get('ccswitch_model') or '?'})") \
        if value == "follow" else value
    if key == "subagent_effort" and value == "off":
        shown = tt("left to Codex", "交给 Codex 决定")
    print(f"{label}: {shown}")
    print(tt("  Applies to new Codex sessions.", "  对新开的 Codex 会话生效"))


def ccmd_status(header=True):
    st = codex_state()
    if header:
        print(tt("Codex routing: ", "Codex 分流 ") + (tt("on", "开启") if st.get("enabled") else tt("off", "关闭")))
    sub = st["subagent"]
    if sub == "follow":
        sub = tt("follow CC Switch", "跟随 CC Switch") + f"（{st.get('ccswitch_model') or '?'}）"
    print(tt("  Main agent:  ", "  主代理   ") + f"{st['main']} @ {st['relay']}"
          + tt(" (fallback ", "（冷却时改用 ") + ", ".join(st.get("fallback_models") or []) + tt(")", "）"))
    print(tt("  Subagents:   ", "  子代理   ") + f"{sub} @ " + (st.get("upstream") or "?"))
    eff = codex_effort(st)
    print(tt("  Subagent effort: ", "  子代理强度 ") + (
        tt(f"{eff} (every spawned subagent; models picked in Codex keep their own effort)",
           f"{eff}（派出的子代理统一使用，在 Codex 里直接选的模型不受影响）") if eff else tt("left to Codex", "交给 Codex 决定")))
    print(tt("  CC Switch model: ", "  CC Switch 当前模型 ") + (st.get("ccswitch_model") or "?"))
    print(tt("  Router:      ", "  本地分流 ") + (tt(f"running on {CODEX_ROUTER_URL}", f"运行中 {CODEX_ROUTER_URL}")
                                                  if codex_router_alive() else tt("not running", "未运行")))


