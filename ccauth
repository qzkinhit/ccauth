def agy_checkin_all(names=None, force_all=False):
    sites = [n for n in agy_site_names() if not names or n in names]
    names = [n for n in (names or agy_provider_names())
             if n in agy_provider_names()
             and (_read_json(os.path.join(agy_provider_dir(), n + ".json"), {}) or {}).get("account")]
    if not names and not sites:
        agy_die("No account logged in yet. Run: ccauth agy login <name> <username>",
                "还没有登录任何账户，先运行 ccauth agy login <名字> <用户名>")
    st = agy_state()
    rec = dict(st.get("checkin") or {})
    ok = True
    today = datetime.now().strftime("%Y-%m-%d")

    def done_today(n):
        r = rec.get(n) or {}
        return r.get("date") == today and r.get("status") in ("done", "already")

    last_host = {"host": None}

    def pace(url):
        """Leave 30 to 60 seconds between accounts on the same site so the requests do not come in a burst."""
        import random
        from urllib.parse import urlparse
        host = urlparse(url).netloc
        if host == last_host["host"]:
            time.sleep(random.uniform(30, 60))
        last_host["host"] = host

    for n in sites:
        stamp = datetime.now().astimezone().isoformat(timespec="seconds")
        if done_today(n) and not force_all:
            continue
        pace((_read_json(os.path.join(agy_sites_dir(), n + ".json"), {}) or {}).get("url", ""))
        try:
            status, got, bal = agy_site_checkin(n)
            word = {"done": tt("checked in", "签到成功"), "already": tt("already checked in", "今天已签到"),
                    "nobonus": tt("logged in, but no check-in record today", "已登录，但今天没有签到记录")}[status]
            gain = f" +${got:.2f}" if got else ""
            tail = (tt(", balance ", "，余额 ") + f"${bal:.2f}") if bal is not None else ""
            msg = f"{n}: {word}{gain}{tail}"
            rec[n] = {"at": stamp, "date": datetime.now().strftime("%Y-%m-%d"), "balance": bal,
                      "status": "error" if status == "nobonus" else status, "awarded": got,
                      "error": word if status == "nobonus" else None}
            ok = ok and status != "nobonus"
        except Exception as e:
            ok = False
            msg = f"{n}: " + tt("check-in failed: ", "签到失败：") + str(e)
            rec[n] = {"at": stamp, "date": datetime.now().strftime("%Y-%m-%d"), "status": "error", "error": str(e)}
        print(time.strftime("%Y-%m-%d %H:%M:%S"), msg, flush=True)
    for n in names:
        if done_today(n) and not force_all:
            continue
        prov = agy_provider(n)
        pace(prov.get("url", ""))
        sess = AgySession(prov)
        stamp = datetime.now().astimezone().isoformat(timespec="seconds")
        try:
            sess.ensure()
            status, got, bal = sess.checkin()
            sess.save()
            word = {"done": tt("checked in", "签到成功"), "already": tt("already checked in", "今天已签到")}[status]
            gain = f" +${got:.2f}" if got is not None else ""
            tail = (tt(", balance ", "，余额 ") + f"${bal:.2f}") if bal is not None else ""
            msg = f"{n} ({sess.acct.get('username')}): {word}{gain}{tail}"
            rec[n] = {"at": stamp, "date": datetime.now().strftime("%Y-%m-%d"), "status": status, "awarded": got,
                      "balance": bal}
        except Exception as e:
            ok = False
            msg = f"{n}: " + tt("check-in failed: ", "签到失败：") + str(e)
            rec[n] = {"at": stamp, "date": datetime.now().strftime("%Y-%m-%d"), "status": "error", "error": str(e)}
        print(time.strftime("%Y-%m-%d %H:%M:%S"), msg, flush=True)
    try:
        agy_refresh_all_models()
    except Exception:
        pass
    st = agy_state()
    st["checkin"] = rec
    agy_state_save(st)
    return ok


IS_WIN = platform.system() == "Windows"
WIN_TASKS = (("ccauth-checkin-0010", "00:10"), ("ccauth-checkin-1210", "12:10"))


def checkin_scheduled():
    if IS_WIN:
        r = subprocess.run(["schtasks", "/Query", "/TN", WIN_TASKS[0][0]], capture_output=True)
        return r.returncode == 0
    return os.path.exists(agy_checkin_plist())


def agy_checkin_install_windows(on):
    for name, _ in WIN_TASKS:
        subprocess.run(["schtasks", "/Delete", "/TN", name, "/F"], capture_output=True)
    if not on:
        print(tt("Daily check-in schedule removed.", "已取消每日自动签到"))
        return
    cmd = subprocess.list2cmdline(self_command() + ["agy", "checkin"])
    for name, at in WIN_TASKS:
        r = subprocess.run(["schtasks", "/Create", "/SC", "DAILY", "/TN", name, "/TR", cmd, "/ST", at, "/F"],
                           capture_output=True, text=True)
        if r.returncode != 0:
            agy_die("Task Scheduler refused the task: " + (r.stderr or r.stdout).strip(),
                    "任务计划程序拒绝创建任务：" + (r.stderr or r.stdout).strip())
    print(tt("Daily check-in scheduled at 00:10 and 12:10 (Task Scheduler).",
             "已设置每日自动签到，时间为 00:10 与 12:10（任务计划程序）"))


def agy_checkin_install(on):
    if IS_WIN:
        return agy_checkin_install_windows(on)
    if not IS_MAC:
        agy_die("Scheduling is implemented for macOS and Windows; use cron on Linux.",
                "定时签到支持 macOS 与 Windows，Linux 请用 cron")
    uid = str(os.getuid())
    subprocess.run(["launchctl", "bootout", f"gui/{uid}/{AGY_CHECKIN_LABEL}"], capture_output=True)
    if not on:
        if os.path.exists(agy_checkin_plist()):
            os.remove(agy_checkin_plist())
        print(tt("Daily check-in schedule removed.", "已取消每日自动签到"))
        return
    py = sys.executable or "/usr/bin/python3"
    log = os.path.join(agy_store(), "checkin.log")
    times = "".join(f"<dict><key>Hour</key><integer>{h}</integer><key>Minute</key><integer>{m}</integer></dict>"
                    for h, m in ((0, 10), (12, 10)))
    plist = f"""<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>{AGY_CHECKIN_LABEL}</string>
  <key>ProgramArguments</key><array>
    <string>{py}</string><string>{agy_script_path()}</string><string>agy</string><string>checkin</string>
  </array>
  <key>EnvironmentVariables</key><dict><key>CCAUTH_HOME</key><string>{STORE}</string></dict>
  <key>StartCalendarInterval</key><array>{times}</array>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>{log}</string>
  <key>StandardErrorPath</key><string>{log}</string>
</dict></plist>
"""
    os.makedirs(os.path.dirname(agy_checkin_plist()), exist_ok=True)
    with open(agy_checkin_plist(), "w") as f:
        f.write(plist)
    subprocess.run(["launchctl", "bootstrap", f"gui/{uid}", agy_checkin_plist()], capture_output=True)
    print(tt(f"Daily check-in scheduled at 00:10 and 12:10 and at login; log: {log}",
             f"已设置每日自动签到，时间为 00:10、12:10 以及开机登录时，日志在 {log}"))


