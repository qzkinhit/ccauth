def system_https_proxy():
    """HTTPS proxy from the environment, else from macOS network settings."""
    px = os.environ.get("HTTPS_PROXY") or os.environ.get("https_proxy")
    if px or not IS_MAC:
        return px or ""
    try:
        out = subprocess.run(["scutil", "--proxy"], capture_output=True, text=True, timeout=5).stdout
        on = re.search(r"HTTPSEnable\s*:\s*1", out)
        host = re.search(r"HTTPSProxy\s*:\s*(\S+)", out)
        port = re.search(r"HTTPSPort\s*:\s*(\d+)", out)
        if on and host and port:
            return f"http://{host.group(1)}:{port.group(1)}"
    except Exception:
        pass
    return ""


