def agy_quota_of(prov):
    """Remaining and used dollars from a NewAPI-style relay, or an error string."""
    base = prov["url"].rstrip("/")
    hdr = {"Authorization": "Bearer " + prov["key"]}

    def get(path):
        req = urllib.request.Request(base + path, headers=hdr)
        with urllib.request.urlopen(req, timeout=20) as r:
            return json.loads(r.read())
    try:
        tok = (get("/api/usage/token/") or {}).get("data") or {}
    except Exception as e:
        return None, None, str(e)
    used_units = tok.get("total_used") or 0
    per_dollar = 500000.0
    try:
        cents = (get("/v1/dashboard/billing/usage") or {}).get("total_usage")
        if cents and used_units:
            per_dollar = used_units / (cents / 100.0)
    except Exception:
        pass
    user = tok.get("user_quota") or {}
    if tok.get("unlimited_quota") and user:
        left = user.get("total_available")
    else:
        left = tok.get("total_available")
    left_usd = None if left is None else left / per_dollar
    return left_usd, used_units / per_dollar, None


def agy_quota_lines():
    act = agy_state().get("active")
    out = []
    for n in agy_provider_names():
        p = _read_json(os.path.join(agy_provider_dir(), n + ".json"), {})
        left, used, err = agy_quota_of(p)
        mark = "*" if n == act else " "
        key = p.get("key") or ""
        tail = "..." + key[-4:] if len(key) > 8 else ""
        if err:
            out.append(f"{mark} {n:<12} {tail:<8} " + tt("query failed: ", "查询失败 ") + err)
            continue
        flag = tt("  (used up today)", "  （今日已用完）") if agy_exhausted(n) else ""
        out.append(f"{mark} {n:<12} {tail:<8} " + tt("left", "剩余") + f" ${left:,.2f}   "
                   + tt("used", "已用") + f" ${used:,.2f}{flag}")
    return out


def agy_refresh_all_models(names=None):
    """Re-read every saved relay's model list now. Returns {name: (added, removed, models, error)}."""
    out = {}
    for n in names or agy_provider_names():
        prov = _read_json(os.path.join(agy_provider_dir(), n + ".json"), {}) or {}
        if not prov:
            continue
        before = list(prov.get("models") or [])
        try:
            after = agy_fetch_models(prov["url"], prov["key"])
            err = None
        except Exception as e:  # noqa: BLE001
            after, err = before, str(e)
        if after and not err:
            disk = _read_json(os.path.join(agy_provider_dir(), n + ".json"), {}) or {}
            disk["models"] = after
            disk["models_checked_at"] = time.time()
            _write_private(os.path.join(agy_provider_dir(), n + ".json"), json.dumps(disk, indent=2))
        out[n] = ([m for m in after if m not in before], [m for m in before if m not in after], after, err)
    try:
        if codex_state().get("enabled"):
            codex_sync(quiet=True)
    except Exception:
        pass
    return out


