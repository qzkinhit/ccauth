            "before writing, then write the complete text or edit in a single step instead of "
            "several partial edits. Do not re-read a file you have just written unless the result "
            "is uncertain. Answer as soon as you have enough information. Never skip a step that "
            "is needed for a correct answer.")
AGY_CHEAP_PREFIX = re.compile(r"(?:^|\n|>)\s*@h(?:\s|$)")


def agy_last_user_text(contents):
    if not isinstance(contents, list) or not contents:
        return ""
    last = contents[-1] if isinstance(contents[-1], dict) else {}
    return "\n".join(p.get("text", "") for p in last.get("parts") or [] if isinstance(p, dict))


AGY_MAIN_PREFIX = re.compile(r"(?:^|\n|>)\s*@m(?:\s|$)")
AGY_WRITING_WORDS = [
    "写作", "撰写", "写一段", "写一篇", "写段", "润色", "改写", "重写", "扩写", "改稿", "修改稿",
    "翻译", "论文", "摘要", "引言", "正文", "段落", "措辞", "文案", "表述", "行文", "语句",
