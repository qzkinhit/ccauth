def _opt(rest, flag):
    if flag in rest:
        i = rest.index(flag)
        if i + 1 < len(rest):
            val = rest[i + 1]
            del rest[i:i + 2]
            return val
        del rest[i]
    for i, a in enumerate(rest):
        if a.startswith(flag + "="):
            del rest[i]
            return a.split("=", 1)[1]
    return None


def agy_main(argv):
    if not argv:
        return acmd_status()
    cmd, rest = argv[0], list(argv[1:])
    force = "--force" in rest or "-f" in rest
    rest = [a for a in rest if a not in ("--force", "-f")]
    if cmd == "add":
        url, key = _opt(rest, "--url"), _opt(rest, "--key")
        models = _opt(rest, "--models")
        default = _opt(rest, "--default")
        if len(rest) != 1:
            die("needs_arg", cmd="agy add")
        acmd_add(rest[0], url, key, [m.strip() for m in models.split(",")] if models else None,
                 default, force)
    elif cmd == "use":
        if len(rest) != 1:
            die("needs_arg", cmd="agy use")
        acmd_use(rest[0])
    elif cmd in ("rm", "remove"):
        if len(rest) != 1:
            die("needs_arg", cmd="agy rm")
        acmd_rm(rest[0])
    elif cmd == "cheap":
        if len(rest) != 2:
            die("needs_arg", cmd="agy cheap <name> <model|off>")
        acmd_cheap(rest[0], rest[1])
    elif cmd == "writing":
        if len(rest) != 2:
            die("needs_arg", cmd="agy writing <name> <on|off>")
        acmd_writing(rest[0], rest[1])
    elif cmd == "login":
        if len(rest) != 2:
            die("needs_arg", cmd="agy login <name> <username>")
        acmd_login(rest[0], rest[1])
    elif cmd == "site":
        if len(rest) not in (3, 4, 5):
            die("needs_arg", cmd="agy site <name> <url> <username> [user_id] [access_token]")
        if len(rest) == 3:
            rest = rest + [""]
        acmd_site(rest[0], rest[1], rest[2], rest[3], rest[4] if len(rest) == 5 else "")
    elif cmd == "checkin":
        if "--install" in rest:
            agy_checkin_install(True)
        elif "--uninstall" in rest:
            agy_checkin_install(False)
        else:
            sys.exit(0 if agy_checkin_all([a for a in rest if not a.startswith("-")] or None,
                                          force_all=bool([a for a in rest if not a.startswith("-")])) else 1)
    elif cmd in ("quota", "balance"):
        acmd_quota()
    elif cmd == "writer":
        if len(rest) != 2:
            die("needs_arg", cmd="agy writer <name> <model|off>")
        acmd_writer(rest[0], rest[1])
    elif cmd == "fallback":
        if len(rest) != 2:
            die("needs_arg", cmd="agy fallback <name> <other|off>")
        acmd_fallback(rest[0], rest[1])
    elif cmd == "hint":
        if len(rest) != 2:
            die("needs_arg", cmd="agy hint <name> <on|off|text>")
        acmd_hint(rest[0], rest[1])
    elif cmd == "save":
        agy_save_session()
    elif cmd in ("list", "ls"):
        acmd_list()
    elif cmd in ("status", "current"):
        acmd_status()
    elif cmd == "path":
        acmd_path()
    elif cmd == "bridge":
        agy_bridge()
    elif cmd in ("help", "--help", "-h"):
        print(AGY_USAGE[LANG].format(version=VERSION))
    elif (cmd == "official" or NAME_RE.match(cmd)) and not rest:
        acmd_use(cmd)
    else:
        print(AGY_USAGE[LANG].format(version=VERSION))
        sys.exit(1)


def main():
    argv = sys.argv[1:]
    if os.path.basename(sys.argv[0]) == "gauth":
        gemini_main(argv)
        return
    if not argv:
        cmd_status()
        return
    cmd, rest = argv[0], argv[1:]
    if cmd == "gemini":
        gemini_main(rest)
        return
    if cmd == "agy":
        agy_main(rest)
        return
    force = "--force" in rest or "-f" in rest
    rest = [a for a in rest if a not in ("--force", "-f")]

    if cmd == "save":
        if len(rest) != 1:
            die("needs_arg", cmd=cmd)
        cmd_save(rest[0], force)
    elif cmd == "use":
        if len(rest) != 1:
            die("needs_arg", cmd=cmd)
        cmd_use(rest[0])
    elif cmd in ("rm", "remove"):
        if len(rest) != 1:
            die("needs_arg", cmd=cmd)
        cmd_rm(rest[0])
    elif cmd in ("list", "ls"):
        cmd_list()
    elif cmd in ("status", "current"):
        cmd_status()
    elif cmd == "path":
        cmd_path()
    elif cmd in ("version", "--version", "-V"):
        print(f"ccauth {VERSION}")
    elif cmd in ("help", "--help", "-h"):
        print(t("usage", version=VERSION))
    elif NAME_RE.match(cmd) and not rest:
        cmd_use(cmd)
    else:
        print(t("usage", version=VERSION))
        sys.exit(1)


if __name__ == "__main__":
    main()
